# SAL example: PaymentSystem (invalid).
# Same as payments.sal, but with two seeded semantic violations:
# - ARCH104: layer Application both may and must not depend on Domain.
# - EFF202: operation TransferFunds effects contain Pure plus DatabaseWrite.

application PaymentSystem.

entity Account:
  has id of type UUID.
  has owner of type String.
  has balance of type Money<USD>.

entity Transfer:
  has id of type UUID.
  has source of type String.
  has destination of type String.
  has amount of type Money<USD>.

layer Domain:
  owns Account.
  owns Transfer.

layer Application:
  owns TransferService.
  owns TransferFunds.
  may depend on Domain.
  must not depend on Domain.
  must not depend on Infrastructure.

layer Infrastructure:
  owns PostgresLedger.
  may depend on Domain.
  may depend on Application.

service TransferService:
  belongs to Application.

operation TransferFunds:
  accepts source of type String.
  accepts destination of type String.
  accepts amount of type Money<USD>.
  returns String.
  effects: Pure, DatabaseWrite.

module PostgresLedger:
  belongs to Infrastructure.
  may read Transfer.
  may modify Transfer.
  forbids HTTPAccess.
