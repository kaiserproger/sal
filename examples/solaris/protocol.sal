        let shortPacket = SolarisDecodeBlockPacket(slice(view(frame), usize(0), usize(9)), usize(0)).
        borrow_end(frame).
        buffer_drop(frameArena).
        if shortPacket.status != -61:
            if failure == 0:
                set failure = 122.
        let tailArena = buffer(usize(5)).
        let tail = borrow_mut(tailArena, usize(0), usize(5)).
        put(tail, usize(0), u8(255)).
        put(tail, usize(1), u8(255)).
        put(tail, usize(2), u8(255)).
        put(tail, usize(3), u8(255)).
        put(tail, usize(4), u8(15)).
        let negativeLength = SolarisDecodeBlockPacket(view(tail), usize(0)).
        put(tail, usize(0), u8(0)).
        put(tail, usize(1), u8(128)).
        put(tail, usize(2), u8(128)).
        put(tail, usize(3), u8(128)).
        put(tail, usize(4), u8(128)).
        let emptyBody = SolarisDecodeBlockPacket(view(tail), usize(0)).
        borrow_end(tail).
        buffer_drop(tailArena).
        if negativeLength.status != -61:
            if failure == 0:
                set failure = 123.
        if emptyBody.status != -61:
            if failure == 0:
                set failure = 124.
        return failure.
