# Solaris wire framing + BlockPos packet ported to safe SAL.
#
# Source (read-only reference, never copied as bytes):
# - crates/mc-protocol/src/codec.rs: ReadMc::read_varint/read_varlong,
#   WriteMc::write_varint/write_varlong (two's-complement little-endian
#   base-128, VarInt at most 5 bytes, VarLong at most 10), read_i64/write_i64
#   big-endian, plus the length-prefixed framing shape the packet layer uses.
# - crates/mc-protocol/src/packets/play.rs: pack_block_pos/unpack_block_pos
#   (see positions.sal for the field layout).
#
# Composition: VarInt/VarLong and big-endian codecs come from the real
# std/binary.sal library (BinaryVarIntRead/Write, BinaryVarLongRead/Write,
# BinaryReadI64Be/BinaryWriteI64Be, BinaryVarIntLength/BinaryVarLongLength);
# packing/unpacking and the negative-coordinate chunk workflow come from
# positions.sal (SolarisPackBlockPos, SolarisUnpackBlockPos,
# SolarisChunkCellOf over std/math.sal floor helpers). No local codec copies,
# no UnsafeMemory, no raw addresses, no foreign callbacks: all state lives
# in the caller's Buffer, borrowed as MutBytes and written with put; reads go
# through Bytes views. Effects are pure throughout except Main's SystemCall
# for Buffer allocation.
#
# Packet layout composed here (framing mirrors mc-protocol: VarInt byte
# length, then body): VarInt packet id ++ 8-byte big-endian packed BlockPos.
# The id values below are illustrative framing inputs, not a claimed vanilla
# packet number; the position payload is the genuine pack_block_pos form.
#
# Error vocabulary: 0 success; -28 output capacity (preflighted, so a failed
# write leaves the span untouched); -61 short body or negative declared
# length; every other malformed input surfaces the binary library's own -22
# (truncation, continuation on the 5th/10th byte, 5th-byte payload above 15,
# 10th-byte payload above 1). Bounded non-minimal encodings decode like the
# Solaris reference (0x80 0x00 reads 0 consuming 2).
use "positions.sal".
use "std/binary.sal".

entity SolarisPacket:
    layout "C".
    has status of type i64.
    has id of type i32.
    has x of type i32.
    has y of type i32.
    has z of type i32.
    has next of type usize.

# Encode one framed block-position record: VarInt length ++ VarInt id ++
# BE64 packed position. Returns the end offset, or -22/-28 with nothing
# published when an offset is out of range or the whole frame does not fit.
operation SolarisEncodeBlockPacket:
    accepts span of type MutBytes.
    accepts offset of type usize.
    accepts id of type i32.
    accepts x of type i32.
    accepts y of type i32.
    accepts z of type i32.
    returns i64.
    body:
        let bodyLength = BinaryVarIntLength(i64(id)) + 8.
        let frameLength = BinaryVarIntLength(bodyLength) + bodyLength.
        if offset > len(span):
            return -22.
        if len(span) - offset < usize(frameLength):
            return -28.
        let first = BinaryVarIntWrite(span, offset, bodyLength).
        if first < 0:
            return first.
        let second = BinaryVarIntWrite(span, offset + usize(first), i64(id)).
        if second < 0:
            return second.
        let third = BinaryWriteI64Be(span, offset + usize(first) + usize(second), SolarisPackBlockPos(x, y, z)).
        if third < 0:
            return third.
        return i64(offset + usize(first) + usize(second) + usize(third)).

# Decode one framed block-position record. The declared length must equal
# exactly the id bytes plus 8 position bytes; any overrun, shortfall, codec
# error, or negative length fails with that status and next echoing offset.
operation SolarisDecodeBlockPacket:
    accepts data of type Bytes.
    accepts offset of type usize.
    returns SolarisPacket.
    body:
        let length = BinaryVarIntRead(data, offset).
        if length.status != 0:
            return SolarisPacket(length.status, 0, 0, 0, 0, offset).
        if length.value < 0:
            return SolarisPacket(-61, 0, 0, 0, 0, offset).
        if offset + length.consumed > len(data):
            return SolarisPacket(-61, 0, 0, 0, 0, offset).
        let total = usize(length.value).
        let bodyStart = offset + length.consumed.
        if len(data) - bodyStart < total:
            return SolarisPacket(-61, 0, 0, 0, 0, offset).
        if total < usize(9):
            return SolarisPacket(-61, 0, 0, 0, 0, offset).
        let id = BinaryVarIntRead(data, bodyStart).
        if id.status != 0:
            return SolarisPacket(id.status, 0, 0, 0, 0, offset).
        if id.consumed + usize(8) != total:
            return SolarisPacket(-61, 0, 0, 0, 0, offset).
        let position = BinaryReadI64Be(data, bodyStart + id.consumed).
        if position.status != 0:
            return SolarisPacket(position.status, 0, 0, 0, 0, offset).
        let unpacked = SolarisUnpackBlockPos(position.value).
        return SolarisPacket(0, i32(id.value), unpacked.x, unpacked.y, unpacked.z, bodyStart + id.consumed + usize(8)).

# Executable parity proof for positions.sal composed with std/binary.sal.
# Returns 0 when every check holds, else the first failing check number.
# Every success byte crosses a caller-owned Buffer; assertions compare exact
# external vectors, signed boundaries, negative coordinates, and all three
# error classes. No UnsafeMemory, no raw addresses, no mocks.
operation Main:
    returns i64.
    effects: SystemCall.
    body:
        let mut failure = 0.
        if PositionsMain() != 0:
