use "std/http.sal".
use "std/net.sal".
use "std/linux/net.sal".
use "std/linux/memory.sal".

# Exchange borrows caller storage; Main retains the socket and Buffer cleanup.
operation WarehouseProbeExchange:
    accepts fd of type i64.
    accepts reply of type MutBytes.
    returns i64.
    requires:
        fd >= 0 otherwise 1.
        len(reply) >= usize(12) otherwise 1.
    effects: SystemCall.
    body:
        if LinuxSocketTimeouts(fd, i64(2)) < 0:
            return 1.
        let request = bytes("POST /stock HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: 18\r\nConnection: close\r\n\r\n{\"warehouse_id\":1}").
        if LinuxWriteAll(fd, request) < 0:
            return 1.
        if LinuxReadExact(fd, reply) < 0:
            return 1.
        let raw = view(reply).
        let prefix = slice(raw, usize(0), usize(12)).
        let ok = prefix == bytes("HTTP/1.1 200").
        borrow_end(prefix).
        borrow_end(raw).
        if !ok:
            return 1.
        return 0.

operation Main:
    returns i64.
    effects: SystemCall.
    body:
        let arena = buffer(usize(4096)).
        let fd = NetTcpConnect(u64(2130706433), i64(8080)).
        let reply = borrow_mut(arena, usize(0), usize(12)).
        let status = WarehouseProbeExchange(fd, reply).
        borrow_end(reply).
        if fd >= 0:
            LinuxClose(fd).
        buffer_drop(arena).
        return status.
