use "std/json_model.sal".
use "std/text_list.sal".
use "std/postgres.sal".

# Bounded JSON request decoder for POST /reserve and /release (needs_codes
# true) and POST /stock (needs_codes false). Requests are described by the
# MutationInput and StockInput schemas below; the declaration lowerer derives
# typed decoders from those schemas on top of the generic JSON-model runtime
# (std/json_model.sal is also pulled in automatically for schema files), so
# this file holds no manual JSON traversal, no key comparisons, and no
# byte-level framing loops. Unknown fields are validated by derived code and
# then ignored; in stock mode "codes" is therefore an ordinary unknown field.
# Recognized duplicate decoded field names are rejected, including across
# escape spellings, and decoded duplicates ("A" vs "\u0041") collide.
#
# Status: 0 success, 400 invalid request, 413 explicit size/count/capacity
# limit. Every rule is a declared clause: body over 65536 bytes or an arena
# loan under 55 bytes fail the decoder headers; more than 64 codes or a code
# over 128 decoded bytes are schema -28 limits; any other schema violation
# (missing warehouse_id in stock mode, missing or empty codes, empty code,
# NUL byte, duplicates, wrong JSON types or grammar) is a negative schema
# status. WarehouseParameters maps schema -28 to 413 and every other negative
# status to 400.
#
# Parameter block: the first parameter is always the warehouse ID as a fixed
# 19-digit zero-padded decimal (PG bigint accepts leading zeros), framed as a
# BE32 length of 19 plus 19 digits, 23 bytes total, written by the generic
# PgPutI64 helper (returns total framed bytes or a negative errno). Codes
# follow in request order as framed by the schema runtime, each already a BE32
# length plus decoded UTF-8 bytes: the TextList framing IS the ordinary PG
# text-parameter framing. parameter_count is code_count + 1 (stock mode:
# code_count 0, one parameter). Consumers read the leading BE32 length rather
# than assuming the fixed width.
#
# Zero-copy placement: the 23-byte ID slot is reserved up front and codes are
# decoded directly into the payload window after it, so codes arriving before
# warehouse_id need no payload move; the decoded DTO is ended before the ID
# slot is written. Decoded payloads grow forward from offset 23 while the
# derived decoder keeps its key scratch (at least 32 bytes) at the storage
# end, so the minimum loan is 55 bytes. Code payloads never overlap the
# unread input; the caller owns that aliasing discipline via disjoint arena
# partitions. Pure safe SAL: offsets and lengths only, no raw addresses.
entity WarehouseRequest:
    layout "C".
    has status of type i64.
    has warehouse_id of type i64.
    has code_count of type i64.
    has parameter_offset of type usize.
    has parameter_bytes of type usize.

entity MutationInput:
    encoding JSON.
    has warehouse_id of type i64.
    has codes of type TextList.
    defaults warehouse_id to 1.
    requires:
        warehouse_id > 0.
        len(codes) > 0.
        len(codes) <= 64 otherwise -28.
        TextListEachNonEmpty(codes).
        TextListEachAtMost(codes, usize(128)) otherwise -28.
        TextListNoNul(codes).
        TextListUnique(codes).

entity StockInput:
    encoding JSON.
    has warehouse_id of type i64.
    requires:
        warehouse_id > 0.

operation WarehouseRejected:
    accepts status of type i64.
    returns WarehouseRequest.
    body:
        return WarehouseRequest(status, 0, 0, usize(0), usize(0)).

# A complete parameter block: the ID slot holds exactly one framed bigint.
operation WarehouseFramed:
    accepts placed of type i64.
    accepts warehouse_id of type i64.
    accepts code_count of type i64.
    accepts framed of type usize.
    returns WarehouseRequest.
    requires:
        placed == 23 otherwise WarehouseRejected(413).
    body:
        return WarehouseRequest(0, warehouse_id, code_count, usize(0), usize(23) + framed).

# Schema status -> HTTP status, then the ID parameter goes into the reserved
# slot in front of the decoded codes.
operation WarehouseParameters:
    accepts status of type i64.
    accepts warehouse_id of type i64.
    accepts code_count of type i64.
    accepts framed of type usize.
    accepts arena of type MutBytes.
    returns WarehouseRequest.
    requires:
        len(arena) >= 23 otherwise WarehouseRejected(413).
        status != -28 otherwise WarehouseRejected(413).
        status == 0 otherwise WarehouseRejected(400).
    body:
        let id_slot = slice_mut(arena, usize(0), usize(23)).
        let placed = PgPutI64(warehouse_id, usize(19), id_slot).
        borrow_end(id_slot).
        return WarehouseFramed(placed, warehouse_id, code_count, framed).

operation WarehouseDecodeMutation:
    accepts body of type Bytes.
    accepts arena of type MutBytes.
    returns WarehouseRequest.
    requires:
        len(body) <= 65536 otherwise WarehouseRejected(413).
        len(arena) >= 55 otherwise WarehouseRejected(413).
    body:
        let payload = slice_mut(arena, usize(23), len(arena) - usize(23)).
        let decoded = MutationInputDecodeJson(body, payload).
        let status = decoded.status.
        let warehouse_id = decoded.value.warehouse_id.
        let code_count = i64(TextListLen(decoded.value.codes)).
        let framed = decoded.written.
        borrow_end(decoded).
        return WarehouseParameters(status, warehouse_id, code_count, framed, arena).

operation WarehouseDecodeStock:
    accepts body of type Bytes.
    accepts arena of type MutBytes.
    returns WarehouseRequest.
    requires:
        len(body) <= 65536 otherwise WarehouseRejected(413).
        len(arena) >= 55 otherwise WarehouseRejected(413).
    body:
        let payload = slice_mut(arena, usize(23), len(arena) - usize(23)).
        let decoded = StockInputDecodeJson(body, payload).
        let status = decoded.status.
        let warehouse_id = decoded.value.warehouse_id.
        borrow_end(payload).
        return WarehouseParameters(status, warehouse_id, 0, usize(0), arena).

operation WarehouseDecodeRequest:
    accepts body of type Bytes.
    accepts needs_codes of type bool.
    accepts arena of type MutBytes.
    returns WarehouseRequest.
    body:
        if needs_codes:
            return WarehouseDecodeMutation(body, arena).
        return WarehouseDecodeStock(body, arena).
