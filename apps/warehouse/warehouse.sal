use "codec.sal".
use "std/binary.sal".
use "std/bytes.sal".
use "std/http.sal".
use "std/json_model.sal".
use "std/server.sal".
use "std/postgres.sal".
use "std/text.sal".

# Warehouse application: HTTP routing, PostgreSQL transactions and JSON
# replies. Every rule is a declared clause next to accepts/returns:
# `requires: COND otherwise VALUE.` gates route/status tables, row
# validation, protocol transitions and transaction steps; reply DTOs are JSON
# schemas whose encoders are derived. Bodies only sequence effects (socket
# I/O, writes into caller loans). No byte framing lives here: PG wire
# handling is std/postgres, JSON writing std/json_model plus derived
# encoders, and every request value travels as a PG Bind parameter.

# Final status of one query or transaction step: 0 success, HTTP-like domain
# status (404/405/409/410/413/504), negative SQL/transport/protocol failure.
entity WarehouseRows:
    layout "C".
    has status of type i64.
    has rows of type i64.
    has written of type i64.
    has available of type bool.

# HTTP status plus error code; http 0 means "no error response".
entity WarehouseFailure:
    has http of type i64.
    has code of type Text.

entity ReserveReply:
    encoding JSON.
    has warehouse_id of type i64.
    has reserved of type i64.

entity ReleaseReply:
    encoding JSON.
    has warehouse_id of type i64.
    has released of type i64.

entity WarehouseMetadata:
    encoding JSON.
    has id of type i64.
    has name of type Text.
    has available of type bool.

entity StockItem:
    encoding JSON.
    has name of type Text.
    has size of type Text.
    has code of type Text.
    has quantity of type i64.
    has reserved of type i64.
    has available_quantity of type i64.

entity ErrorDetail:
    encoding JSON.
    has code of type Text.

entity ErrorReply:
    encoding JSON.
    has error of type ErrorDetail.

# ---------------------------------------------------------------------------
# Route and status tables.
# ---------------------------------------------------------------------------

# Action: 0 stock, 1 reserve, 2 release, -1 unknown path.
operation WarehouseActionFor:
    accepts path of type Bytes.
    returns i64.
    requires:
        path != bytes("/stock") otherwise 0.
        path != bytes("/reserve") otherwise 1.
        path != bytes("/release") otherwise 2.
    body:
        return -1.

operation WarehouseAccepted:
    returns WarehouseFailure.
    body:
        return WarehouseFailure(0, "").

# HttpReadRequest failures; any other negative closes without a response.
operation WarehouseReadFailure:
    accepts received of type i64.
    returns WarehouseFailure.
    requires:
        received != -400 otherwise WarehouseFailure(400, "invalid_request").
        received != -413 otherwise WarehouseFailure(413, "request_too_large").
        received != -431 otherwise WarehouseFailure(431, "headers_too_large").
        received != -11 && received != -110 otherwise WarehouseFailure(408, "request_timeout").
    body:
        return WarehouseAccepted().

operation WarehouseRouteFailure:
    accepts action of type i64.
    accepts method of type Bytes.
    accepts body_offset of type i64.
    returns WarehouseFailure.
    requires:
        action >= 0 otherwise WarehouseFailure(404, "action_not_found").
        method == bytes("POST") otherwise WarehouseFailure(405, "method_not_allowed").
        body_offset >= 0 otherwise WarehouseFailure(400, "invalid_request").
    body:
        return WarehouseAccepted().

operation WarehouseDecodeFailure:
    accepts status of type i64.
    returns WarehouseFailure.
    requires:
        status != 413 otherwise WarehouseFailure(413, "request_too_large").
        status == 0 otherwise WarehouseFailure(400, "invalid_request").
    body:
        return WarehouseAccepted().

# Transaction outcome to HTTP error; 405 is the internal "a code matched no
# inventory row" status and 410 "warehouse unavailable for reservations".
operation WarehouseOutcomeFailure:
    accepts status of type i64.
    accepts action of type i64.
    returns WarehouseFailure.
    requires:
        status != 404 otherwise WarehouseFailure(404, "warehouse_not_found").
        status != 405 otherwise WarehouseFailure(404, "item_not_found").
        status != 410 otherwise WarehouseFailure(409, "warehouse_unavailable").
        status != 409 || action == 2 otherwise WarehouseFailure(409, "insufficient_stock").
        status != 409 otherwise WarehouseFailure(409, "insufficient_reservation").
        status != 413 otherwise WarehouseFailure(413, "result_too_large").
        status != 504 otherwise WarehouseFailure(503, "commit_outcome_unknown").
    body:
        return WarehouseFailure(503, "database_error").

# ---------------------------------------------------------------------------
# SQL per action. Only placeholder NUMBERS enter SQL construction; every
# request value stays in the codec's bounded Bind block.
# ---------------------------------------------------------------------------

operation WarehouseBeginSql:
    accepts action of type i64.
    returns Bytes.
    requires:
        action != 0 otherwise bytes("BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY").
    body:
        return bytes("BEGIN").

operation WarehouseMetadataSql:
    accepts action of type i64.
    returns Bytes.
    requires:
        action != 0 otherwise bytes("SELECT id,name,available FROM warehouses WHERE id=$1").
    body:
        return bytes("SELECT id,name,available FROM warehouses WHERE id=$1 FOR SHARE").

operation WarehouseUpdateSql:
    accepts action of type i64.
    returns Bytes.
    requires:
        action != 2 otherwise bytes("UPDATE inventory SET reserved=reserved-1 FROM items WHERE items.id=inventory.item_id AND inventory.warehouse_id=$1 AND items.code IN (").
    body:
        return bytes("UPDATE inventory SET reserved=reserved+1 FROM items WHERE items.id=inventory.item_id AND inventory.warehouse_id=$1 AND items.code IN (").

# Query modes: 0 command, 1 warehouse, 2 encoded warehouse, 3 reserve locks,
# 4 release locks, 5 encoded stock, 6 UPDATE.
operation WarehouseMetadataMode:
    accepts action of type i64.
    returns i64.
    requires:
        action != 0 otherwise 2.
    body:
        return 1.

operation WarehouseLockMode:
    accepts action of type i64.
    returns i64.
    requires:
        action != 2 otherwise 4.
    body:
        return 3.

operation WarehousePlaceholderSeparator:
    accepts index of type i64.
    returns Bytes.
    requires:
        index > 0 otherwise bytes("$").
    body:
        return bytes(",$").

# `prefix $2,$3,...,$<count+1> suffix`; offsets propagate negatives.
operation WarehouseCodesSql:
    accepts prefix of type Bytes.
    accepts suffix of type Bytes.
    accepts count of type i64.
    accepts output of type MutBytes.
    returns i64.
    requires:
        count >= 1 && count <= 64 otherwise -22.
    body:
        let mut written = BytesAppend(output, 0, prefix).
        let mut index = 0.
        while index < count:
            set written = BytesDecimalAt(output, BytesAppend(output, written, WarehousePlaceholderSeparator(index)), index + 2).
            set index = index + 1.
        return BytesAppend(output, written, suffix).

# ---------------------------------------------------------------------------
# Row fields.
# ---------------------------------------------------------------------------

operation WarehouseNonNegative:
    accepts value of type i64.
    returns i64.
    requires:
        value >= 0 otherwise -71.
    body:
        return value.

# Non-negative decimal field or -71.
operation WarehouseFieldDecimal:
    accepts message of type Bytes.
    accepts field of type PgField.
    returns i64.
    requires:
        field.length >= 1 otherwise -71.
    body:
        let value = PgFieldBytes(message, field).
        let result = BytesParseDecimal(value).
        borrow_end(value).
        return WarehouseNonNegative(result).

# Positive ID-width decimal field (1..19 digits) or -71.
operation WarehouseFieldNumber:
    accepts message of type Bytes.
    accepts field of type PgField.
    returns i64.
    requires:
        field.length >= 1 && field.length <= 19 otherwise -71.
    body:
        return WarehouseFieldDecimal(message, field).

# Non-empty text field of at most limit bytes with no NUL byte.
operation WarehouseFieldText:
    accepts message of type Bytes.
    accepts field of type PgField.
    accepts limit of type i64.
    returns bool.
    requires:
        field.length >= 1 && field.length <= limit otherwise false.
    body:
        let value = PgFieldBytes(message, field).
        let nul = TextFindByte(value, usize(0), u8(0)).
        borrow_end(value).
        return nul == -1.

operation WarehouseFlagValue:
    accepts flag of type Bytes.
    returns i64.
    requires:
        flag != bytes("t") otherwise 1.
        flag != bytes("f") otherwise 0.
    body:
        return -71.

# PG boolean text field: 1 true, 0 false, -71 malformed.
operation WarehouseFieldFlag:
    accepts message of type Bytes.
    accepts field of type PgField.
    returns i64.
    requires:
        field.length == 1 otherwise -71.
    body:
        let flag = PgFieldBytes(message, field).
        let truth = WarehouseFlagValue(flag).
        borrow_end(flag).
        return truth.

operation WarehouseFieldAt:
    accepts message of type Bytes.
    accepts index of type i64.
    returns i64.
    body:
        return PgRowField(message, index).length.

# ---------------------------------------------------------------------------
# One Parse+Bind+Execute+Sync exchange (no Describe) as a declared state
# machine. stage: 0 sent, 1 ParseComplete, 2 BindComplete, 4
# CommandComplete, 5 ErrorResponse. failure keeps the first SQL error
# through ReadyForQuery; done marks the final status. A malformed frame or
# lost connection finishes immediately: the owner must close, not reuse it.
# No per-row allocation or ID copying.
# ---------------------------------------------------------------------------

entity WarehouseProgress:
    layout "C".
    has done of type bool.
    has status of type i64.
    has stage of type i64.
    has failure of type i64.
    has rows of type i64.
    has written of type i64.
    has available of type bool.
    has previous_id of type i64.

entity WarehousePlan:
    layout "C".
    has mode of type i64.
    has expected_rows of type i64.
    has ready_state of type u8.

# CommandComplete facts: tag present, equals the expected command tag,
# carries the mode's SELECT/UPDATE prefix, and its row count (-1 if none).
entity WarehouseTag:
    layout "C".
    has present of type bool.
    has is_command of type bool.
    has counted of type bool.
    has count of type i64.

operation WarehouseStarted:
    accepts sent of type i64.
    accepts offset of type i64.
    returns WarehouseProgress.
    requires:
        sent >= 0 otherwise WarehouseProgress(true, sent, 0, 0, 0, offset, false, 0).
    body:
        return WarehouseProgress(false, 0, 0, 0, 0, offset, false, 0).

operation WarehouseFinish:
    accepts progress of type WarehouseProgress.
    accepts status of type i64.
    returns WarehouseProgress.
    body:
        return WarehouseProgress(true, status, progress.stage, progress.failure, progress.rows, progress.written, progress.available, progress.previous_id).

operation WarehouseAt:
    accepts progress of type WarehouseProgress.
    accepts stage of type i64.
    returns WarehouseProgress.
    body:
        return WarehouseProgress(false, 0, stage, progress.failure, progress.rows, progress.written, progress.available, progress.previous_id).

operation WarehouseCounted:
    accepts progress of type WarehouseProgress.
    returns WarehouseProgress.
    body:
        return WarehouseProgress(false, 0, progress.stage, progress.failure, progress.rows + 1, progress.written, progress.available, progress.previous_id).

operation WarehouseWritten:
    accepts progress of type WarehouseProgress.
    accepts written of type i64.
    returns WarehouseProgress.
    body:
        return WarehouseProgress(progress.done, progress.status, progress.stage, progress.failure, progress.rows, written, progress.available, progress.previous_id).

operation WarehouseFirstFailure:
    accepts failure of type i64.
    accepts status of type i64.
    returns i64.
    requires:
        failure >= 0 otherwise failure.
    body:
        return status.

operation WarehouseTagPrefix:
    accepts mode of type i64.
    returns Bytes.
    requires:
        mode != 6 otherwise bytes("UPDATE ").
    body:
        return bytes("SELECT ").

operation WarehouseTagCount:
    accepts tag of type Bytes.
    accepts prefix of type Bytes.
    accepts counted of type bool.
    returns i64.
    requires:
        counted otherwise -1.
    body:
        let digits = slice(tag, len(prefix), len(tag) - len(prefix)).
        let count = BytesParseDecimal(digits).
        borrow_end(digits).
        return count.

operation WarehouseTagOf:
    accepts tag of type Bytes.
    accepts command of type Bytes.
    accepts mode of type i64.
    returns WarehouseTag.
    body:
        let prefix = WarehouseTagPrefix(mode).
        let counted = BytesStartsWith(tag, prefix).
        let count = WarehouseTagCount(tag, prefix, counted && mode != 0).
        borrow_end(prefix).
        return WarehouseTag(len(tag) >= usize(1), tag == command, counted, count).

operation WarehouseOnError:
    accepts progress of type WarehouseProgress.
    accepts status of type i64.
    returns WarehouseProgress.
    requires:
        progress.stage != 4 && progress.stage != 5 otherwise WarehouseFinish(progress, -71).
    body:
        return WarehouseProgress(false, 0, 5, WarehouseFirstFailure(progress.failure, status), progress.rows, progress.written, progress.available, progress.previous_id).

operation WarehouseOnReady:
    accepts progress of type WarehouseProgress.
    accepts state of type u8.
    accepts ready_state of type u8.
    returns WarehouseProgress.
    requires:
        state == 73 || state == 84 || state == 69 otherwise WarehouseFinish(progress, -71).
        progress.stage != 5 || progress.failure >= -4095 otherwise WarehouseFinish(progress, progress.failure).
        progress.stage == 4 && state == ready_state otherwise WarehouseFinish(progress, -71).
        progress.failure != 0 || progress.written >= 0 || progress.written == -28 otherwise WarehouseFinish(progress, -71).
        progress.failure != 0 || progress.written != -28 otherwise WarehouseFinish(progress, 413).
    body:
        return WarehouseFinish(progress, progress.failure).

operation WarehouseOnComplete:
    accepts progress of type WarehouseProgress.
    accepts tag of type WarehouseTag.
    accepts plan of type WarehousePlan.
    returns WarehouseProgress.
    requires:
        tag.present otherwise WarehouseFinish(progress, -71).
        plan.mode != 0 || (progress.rows == 0 && tag.is_command) otherwise WarehouseFinish(progress, -71).
        plan.mode == 0 || (tag.counted && tag.count >= 0) otherwise WarehouseFinish(progress, -71).
        plan.mode != 6 || (tag.count == plan.expected_rows && progress.rows == 0) otherwise WarehouseFinish(progress, -71).
        plan.mode == 0 || plan.mode == 6 || tag.count == progress.rows otherwise WarehouseFinish(progress, -71).
    body:
        return WarehouseAt(progress, 4).

# Reserve/release lock rows arrive in strictly increasing item-ID order;
# an exhausted (reserve) or empty (release) row marks failure 409.
operation WarehouseLockFailure:
    accepts mode of type i64.
    accepts quantity of type i64.
    accepts reserved of type i64.
    accepts failure of type i64.
    returns i64.
    requires:
        mode != 3 || reserved != quantity otherwise 409.
        mode != 4 || reserved != 0 otherwise 409.
    body:
        return failure.

operation WarehouseLockRow:
    accepts progress of type WarehouseProgress.
    accepts plan of type WarehousePlan.
    accepts id of type i64.
    accepts quantity of type i64.
    accepts reserved of type i64.
    returns WarehouseProgress.
    requires:
        quantity >= 0 && reserved >= 0 otherwise WarehouseFinish(progress, -71).
        id > progress.previous_id && reserved <= quantity otherwise WarehouseFinish(progress, -71).
        progress.rows <= plan.expected_rows otherwise WarehouseFinish(progress, -71).
    body:
        return WarehouseProgress(false, 0, progress.stage, WarehouseLockFailure(plan.mode, quantity, reserved, progress.failure), progress.rows, progress.written, progress.available, id).

# `at` advanced by an encoder result, or the encoder's negative status.
operation WarehouseAdvanced:
    accepts at of type i64.
    accepts wrote of type i64.
    returns i64.
    requires:
        wrote >= 0 otherwise wrote.
    body:
        return at + wrote.

operation WarehouseLiteral:
    accepts output of type MutBytes.
    accepts at of type i64.
    accepts value of type Bytes.
    returns i64.
    requires:
        at >= 0 otherwise at.
    body:
        return JsonModelWriteLiteral(value, output, usize(at)).

operation WarehouseField:
    accepts output of type MutBytes.
    accepts at of type i64.
    accepts name of type Text.
    accepts first of type bool.
    returns i64.
    requires:
        at >= 0 otherwise at.
    body:
        return JsonModelWriteField(name, first, output, usize(at)).

operation WarehouseMetadataAt:
    accepts output of type MutBytes.
    accepts at of type i64.
    accepts metadata of type WarehouseMetadata.
    returns i64.
    requires:
        at >= 0 otherwise at.
    body:
        let loan = slice_mut(output, usize(at), len(output) - usize(at)).
        let wrote = WarehouseMetadataEncodeJson(metadata, loan).
        borrow_end(loan).
        return WarehouseAdvanced(at, wrote).

# Item separator before every stock row after the first.
operation WarehouseItemAt:
    accepts output of type MutBytes.
    accepts at of type i64.
    accepts first of type bool.
    returns i64.
    requires:
        !first otherwise at.
    body:
        return WarehouseLiteral(output, at, bytes(",")).

# Capacity failures are 413 (complete error, never truncated JSON), anything
# else a protocol failure.
operation WarehouseWriteFailure:
    accepts written of type i64.
    returns i64.
    requires:
        written != -28 otherwise 413.
    body:
        return -71.

operation WarehouseWrote:
    accepts progress of type WarehouseProgress.
    accepts written of type i64.
    returns WarehouseProgress.
    requires:
        written >= 0 otherwise WarehouseFinish(progress, WarehouseWriteFailure(written)).
    body:
        return WarehouseWritten(progress, written).

# Stock listing head `{"warehouse":<metadata>,"items":[`.
operation WarehouseListingHead:
    accepts progress of type WarehouseProgress.
    accepts id of type i64.
    accepts message of type Bytes.
    accepts output of type MutBytes.
    returns WarehouseProgress.
    body:
        let nameBytes = PgFieldBytes(message, PgRowField(message, 1)).
        let name = text(nameBytes).
        let opened = WarehouseLiteral(output, progress.written, bytes("{")).
        let labelled = WarehouseField(output, opened, "warehouse", true).
        let described = WarehouseMetadataAt(output, labelled, WarehouseMetadata(id, name, progress.available)).
        let listed = WarehouseField(output, described, "items", false).
        let items = WarehouseLiteral(output, listed, bytes("[")).
        borrow_end(name).
        borrow_end(nameBytes).
        return WarehouseWrote(progress, items).

# Warehouse metadata row (modes 1 and 2): exactly one row with a positive
# ID, a bounded name and a boolean availability flag.
operation WarehouseMetadataRow:
    accepts progress of type WarehouseProgress.
    accepts mode of type i64.
    accepts message of type Bytes.
    accepts output of type MutBytes.
    returns WarehouseProgress.
    requires:
        progress.rows == 1 otherwise WarehouseFinish(progress, -71).
        WarehouseFieldNumber(message, PgRowField(message, 0)) >= 1 otherwise WarehouseFinish(progress, -71).
        WarehouseFieldText(message, PgRowField(message, 1), 256) otherwise WarehouseFinish(progress, -71).
        WarehouseFieldFlag(message, PgRowField(message, 2)) >= 0 otherwise WarehouseFinish(progress, -71).
        mode == 2 otherwise WarehouseProgress(false, 0, progress.stage, progress.failure, progress.rows, progress.written, WarehouseFieldFlag(message, PgRowField(message, 2)) == 1, progress.previous_id).
    body:
        let available = WarehouseFieldFlag(message, PgRowField(message, 2)) == 1.
        let marked = WarehouseProgress(false, 0, progress.stage, progress.failure, progress.rows, progress.written, available, progress.previous_id).
        return WarehouseListingHead(marked, WarehouseFieldNumber(message, PgRowField(message, 0)), message, output).

# Stock row (mode 5): bounded name/size/code texts and consistent counts,
# appended as one derived StockItem JSON object.
operation WarehouseStockRow:
    accepts progress of type WarehouseProgress.
    accepts message of type Bytes.
    accepts output of type MutBytes.
    returns WarehouseProgress.
    requires:
        WarehouseFieldDecimal(message, PgRowField(message, 3)) >= 0 otherwise WarehouseFinish(progress, -71).
        WarehouseFieldDecimal(message, PgRowField(message, 4)) >= 0 otherwise WarehouseFinish(progress, -71).
        WarehouseFieldDecimal(message, PgRowField(message, 5)) >= 0 otherwise WarehouseFinish(progress, -71).
        WarehouseFieldText(message, PgRowField(message, 0), 256) otherwise WarehouseFinish(progress, -71).
        WarehouseFieldText(message, PgRowField(message, 1), 64) otherwise WarehouseFinish(progress, -71).
        WarehouseFieldText(message, PgRowField(message, 2), 128) otherwise WarehouseFinish(progress, -71).
        WarehouseFieldDecimal(message, PgRowField(message, 4)) <= WarehouseFieldDecimal(message, PgRowField(message, 3)) otherwise WarehouseFinish(progress, -71).
        WarehouseFieldDecimal(message, PgRowField(message, 5)) == WarehouseFieldDecimal(message, PgRowField(message, 3)) - WarehouseFieldDecimal(message, PgRowField(message, 4)) otherwise WarehouseFinish(progress, -71).
    body:
        let at = WarehouseItemAt(output, progress.written, progress.rows == 1).
        let nameBytes = PgFieldBytes(message, PgRowField(message, 0)).
        let sizeBytes = PgFieldBytes(message, PgRowField(message, 1)).
        let codeBytes = PgFieldBytes(message, PgRowField(message, 2)).
        let item = StockItem(text(nameBytes), text(sizeBytes), text(codeBytes), WarehouseFieldDecimal(message, PgRowField(message, 3)), WarehouseFieldDecimal(message, PgRowField(message, 4)), WarehouseFieldDecimal(message, PgRowField(message, 5))).
        let written = WarehouseStockItemAt(output, at, item).
        borrow_end(item).
        borrow_end(nameBytes).
        borrow_end(sizeBytes).
        borrow_end(codeBytes).
        return WarehouseWrote(progress, written).

operation WarehouseStockItemAt:
    accepts output of type MutBytes.
    accepts at of type i64.
    accepts item of type StockItem.
    returns i64.
    requires:
        at >= 0 otherwise at.
    body:
        let loan = slice_mut(output, usize(at), len(output) - usize(at)).
        let wrote = StockItemEncodeJson(item, loan).
        borrow_end(loan).
        return WarehouseAdvanced(at, wrote).

operation WarehouseFieldCount:
    accepts mode of type i64.
    returns i64.
    requires:
        mode != 5 otherwise 6.
    body:
        return 3.

# DataRow (kind 68) in a row-returning mode, already counted.
operation WarehouseOnRow:
    accepts progress of type WarehouseProgress.
    accepts plan of type WarehousePlan.
    accepts message of type Bytes.
    accepts output of type MutBytes.
    returns WarehouseProgress.
    requires:
        PgReadU16(message, usize(5)) == WarehouseFieldCount(plan.mode) otherwise WarehouseFinish(progress, -71).
        WarehouseFieldAt(message, 0) >= 0 && WarehouseFieldAt(message, 1) >= 0 && WarehouseFieldAt(message, 2) >= 0 otherwise WarehouseFinish(progress, -71).
        plan.mode != 3 && plan.mode != 4 otherwise WarehouseLockRow(progress, plan, WarehouseFieldNumber(message, PgRowField(message, 0)), WarehouseFieldDecimal(message, PgRowField(message, 1)), WarehouseFieldDecimal(message, PgRowField(message, 2))).
    body:
        if plan.mode == 5:
            return WarehouseStockRow(progress, message, output).
        return WarehouseMetadataRow(progress, plan.mode, message, output).

# One backend message. Notices, parameter status and notifications are
# ignored; everything else must follow the exact exchange order.
operation WarehouseStep:
    accepts progress of type WarehouseProgress.
    accepts kind of type i64.
    accepts status of type i64.
    accepts state of type u8.
    accepts tag of type WarehouseTag.
    accepts plan of type WarehousePlan.
    accepts message of type Bytes.
    accepts output of type MutBytes.
    returns WarehouseProgress.
    requires:
        status != -71 otherwise WarehouseFinish(progress, -71).
        kind != 78 && kind != 83 && kind != 65 otherwise progress.
        kind != 69 otherwise WarehouseOnError(progress, status).
        kind != 90 otherwise WarehouseOnReady(progress, state, plan.ready_state).
        progress.stage != 0 || kind != 49 otherwise WarehouseAt(progress, 1).
        progress.stage != 1 || kind != 50 otherwise WarehouseAt(progress, 2).
        progress.stage == 2 otherwise WarehouseFinish(progress, -71).
        kind != 67 otherwise WarehouseOnComplete(progress, tag, plan).
        kind == 68 && plan.mode != 0 && plan.mode != 6 otherwise WarehouseFinish(progress, -71).
    body:
        return WarehouseOnRow(WarehouseCounted(progress), plan, message, output).

operation WarehouseReceived:
    accepts progress of type WarehouseProgress.
    accepts received of type i64.
    accepts plan of type WarehousePlan.
    accepts command of type Bytes.
    accepts scratch of type MutBytes.
    accepts output of type MutBytes.
    returns WarehouseProgress.
    requires:
        received >= 0 otherwise WarehouseFinish(progress, received).
    body:
        let reply = view(scratch).
        let message = slice(reply, usize(0), usize(received)).
        let event = PgClassify(message).
        let tag = WarehouseTagOf(event.command_tag, command, plan.mode).
        let next = WarehouseStep(progress, event.kind, event.status, event.ready_state, tag, plan, message, output).
        borrow_end(event).
        borrow_end(message).
        borrow_end(reply).
        return next.

operation WarehouseQuery:
    accepts fd of type i64.
    accepts query of type Bytes.
    accepts parameter_count of type i64.
    accepts parameters of type Bytes.
    accepts mode of type i64.
    accepts command of type Bytes.
    accepts expected_rows of type i64.
    accepts ready_state of type u8.
    accepts scratch of type MutBytes.
    accepts output of type MutBytes.
    accepts offset of type i64.
    returns WarehouseRows.
    effects: SystemCall.
    body:
        let plan = WarehousePlan(mode, expected_rows, ready_state).
        let mut progress = WarehouseStarted(PgSendQuery(fd, query, parameter_count, parameters, scratch), offset).
        while !progress.done:
            set progress = WarehouseReceived(progress, PgReadMessage(fd, scratch), plan, command, scratch, output).
        return WarehouseRows(progress.status, progress.rows, progress.written, progress.available).

# ---------------------------------------------------------------------------
# Transaction steps. Each step runs only when the previous one succeeded;
# the first failure flows through unchanged to WarehouseSettle.
# ---------------------------------------------------------------------------

operation WarehouseRejectedRows:
    accepts status of type i64.
    returns WarehouseRows.
    body:
        return WarehouseRows(status, 0, 0, false).

# Rollback only after Ready (SQL failure or domain status); a transport
# failure leaves nothing to roll back. Rollback never replaces the primary.
operation WarehouseRollback:
    accepts fd of type i64.
    accepts scratch of type MutBytes.
    accepts empty of type MutBytes.
    accepts primary of type i64.
    returns i64.
    requires:
        primary >= 0 || primary < -4095 otherwise primary.
    effects: SystemCall.
    body:
        return WarehouseQuery(fd, bytes("ROLLBACK"), 0, bytes(""), 0, bytes("ROLLBACK"), 0, u8(73), scratch, empty, 0).status.

operation WarehouseAbort:
    accepts fd of type i64.
    accepts scratch of type MutBytes.
    accepts empty of type MutBytes.
    accepts failed of type WarehouseRows.
    returns WarehouseRows.
    effects: SystemCall.
    body:
        WarehouseRollback(fd, scratch, empty, failed.status).
        LinuxClose(fd).
        return failed.

# A lost, partial or malformed COMMIT reply has unknown outcome (504): never
# rollback, replay or compensate once COMMIT has been sent.
operation WarehouseCommitted:
    accepts committed of type WarehouseRows.
    accepts prepared of type WarehouseRows.
    returns WarehouseRows.
    requires:
        committed.status >= 0 || committed.status < -4095 otherwise WarehouseRejectedRows(504).
        committed.status == 0 otherwise committed.
    body:
        return WarehouseRows(0, 0, prepared.written, prepared.available).

# Every transaction closes its fd exactly once here.
operation WarehouseSettle:
    accepts fd of type i64.
    accepts prepared of type WarehouseRows.
    accepts scratch of type MutBytes.
    accepts output of type MutBytes.
    accepts empty of type MutBytes.
    returns WarehouseRows.
    effects: SystemCall.
    body:
        if prepared.status != 0:
            return WarehouseAbort(fd, scratch, empty, prepared).
        let committed = WarehouseQuery(fd, bytes("COMMIT"), 0, bytes(""), 0, bytes("COMMIT"), 0, u8(73), scratch, output, prepared.written).
        LinuxClose(fd).
        return WarehouseCommitted(committed, prepared).

operation WarehouseFound:
    accepts warehouse of type WarehouseRows.
    accepts action of type i64.
    returns WarehouseRows.
    requires:
        warehouse.status == 0 otherwise warehouse.
        warehouse.rows == 1 otherwise WarehouseRejectedRows(404).
        action != 1 || warehouse.available otherwise WarehouseRejectedRows(410).
    body:
        return warehouse.

operation WarehouseLookup:
    accepts fd of type i64.
    accepts begun of type WarehouseRows.
    accepts action of type i64.
    accepts parameter of type Bytes.
    accepts scratch of type MutBytes.
    accepts output of type MutBytes.
    returns WarehouseRows.
    requires:
        begun.status == 0 otherwise begun.
    effects: SystemCall.
    body:
        let warehouse = WarehouseQuery(fd, WarehouseMetadataSql(action), 1, parameter, WarehouseMetadataMode(action), bytes(""), 1, u8(84), scratch, output, 0).
        return WarehouseFound(warehouse, action).

operation WarehouseReplied:
    accepts written of type i64.
    accepts available of type bool.
    returns WarehouseRows.
    requires:
        written >= 0 otherwise WarehouseRejectedRows(413).
    body:
        return WarehouseRows(0, 0, written, available).

operation WarehouseListed:
    accepts stock of type WarehouseRows.
    accepts available of type bool.
    accepts output of type MutBytes.
    returns WarehouseRows.
    requires:
        stock.status == 0 otherwise stock.
    body:
        return WarehouseReplied(WarehouseLiteral(output, stock.written, bytes("]}")), available).

# Stock: repeatable-read snapshot of metadata plus rows sorted by code bytes.
operation WarehouseListing:
    accepts fd of type i64.
    accepts found of type WarehouseRows.
    accepts parameter of type Bytes.
    accepts scratch of type MutBytes.
    accepts output of type MutBytes.
    returns WarehouseRows.
    requires:
        found.status == 0 otherwise found.
    effects: SystemCall.
    body:
        let stock = WarehouseQuery(fd, bytes("SELECT items.name,items.size,items.code,inventory.quantity,inventory.reserved,inventory.quantity-inventory.reserved FROM inventory JOIN items ON items.id=inventory.item_id WHERE inventory.warehouse_id=$1 ORDER BY items.code COLLATE \"C\""), 1, parameter, 5, bytes(""), 0, u8(84), scratch, output, found.written).
        return WarehouseListed(stock, found.available, output).

# Every requested code must lock exactly one inventory row.
operation WarehouseLocked:
    accepts locked of type WarehouseRows.
    accepts count of type i64.
    returns WarehouseRows.
    requires:
        locked.status >= 0 otherwise locked.
        locked.rows == count otherwise WarehouseRejectedRows(405).
    body:
        return locked.

# Run the first `size` bytes of sql (negative size: SQL did not fit, 413).
operation WarehouseCodesQuery:
    accepts fd of type i64.
    accepts size of type i64.
    accepts request of type WarehouseRequest.
    accepts parameters of type Bytes.
    accepts mode of type i64.
    accepts sql of type MutBytes.
    accepts scratch of type MutBytes.
    accepts empty of type MutBytes.
    returns WarehouseRows.
    requires:
        size >= 0 otherwise WarehouseRejectedRows(413).
    effects: SystemCall.
    body:
        let sqlView = view(sql).
        let text = slice(sqlView, usize(0), usize(size)).
        let result = WarehouseQuery(fd, text, request.code_count + 1, parameters, mode, bytes(""), request.code_count, u8(84), scratch, empty, 0).
        borrow_end(text).
        borrow_end(sqlView).
        return result.

# Mutations lock inventory rows in item-ID order, then update the batch.
operation WarehouseLock:
    accepts fd of type i64.
    accepts found of type WarehouseRows.
    accepts request of type WarehouseRequest.
    accepts parameters of type Bytes.
    accepts action of type i64.
    accepts sql of type MutBytes.
    accepts scratch of type MutBytes.
    accepts empty of type MutBytes.
    returns WarehouseRows.
    requires:
        found.status == 0 otherwise found.
    effects: SystemCall.
    body:
        let size = WarehouseCodesSql(bytes("SELECT inventory.item_id,inventory.quantity,inventory.reserved FROM inventory JOIN items ON items.id=inventory.item_id WHERE inventory.warehouse_id=$1 AND items.code IN ("), bytes(") ORDER BY inventory.item_id FOR UPDATE OF inventory"), request.code_count, sql).
        return WarehouseLockRun(fd, size, request, parameters, action, sql, scratch, empty).

# A lock SQL that did not fit is 413, never an "item not found" row count.
operation WarehouseLockRun:
    accepts fd of type i64.
    accepts size of type i64.
    accepts request of type WarehouseRequest.
    accepts parameters of type Bytes.
    accepts action of type i64.
    accepts sql of type MutBytes.
    accepts scratch of type MutBytes.
    accepts empty of type MutBytes.
    returns WarehouseRows.
    requires:
        size >= 0 otherwise WarehouseRejectedRows(413).
    effects: SystemCall.
    body:
        return WarehouseLocked(WarehouseCodesQuery(fd, size, request, parameters, WarehouseLockMode(action), sql, scratch, empty), request.code_count).

operation WarehouseUpdate:
    accepts fd of type i64.
    accepts locked of type WarehouseRows.
    accepts request of type WarehouseRequest.
    accepts parameters of type Bytes.
    accepts action of type i64.
    accepts sql of type MutBytes.
    accepts scratch of type MutBytes.
    accepts empty of type MutBytes.
    returns WarehouseRows.
    requires:
        locked.status == 0 otherwise locked.
    effects: SystemCall.
    body:
        let size = WarehouseCodesSql(WarehouseUpdateSql(action), bytes(")"), request.code_count, sql).
        return WarehouseCodesQuery(fd, size, request, parameters, 6, sql, scratch, empty).

operation WarehouseMutationEncode:
    accepts request of type WarehouseRequest.
    accepts action of type i64.
    accepts output of type MutBytes.
    returns i64.
    body:
        if action == 1:
            return ReserveReplyEncodeJson(ReserveReply(request.warehouse_id, request.code_count), output).
        return ReleaseReplyEncodeJson(ReleaseReply(request.warehouse_id, request.code_count), output).

operation WarehouseMutationReply:
    accepts updated of type WarehouseRows.
    accepts request of type WarehouseRequest.
    accepts action of type i64.
    accepts available of type bool.
    accepts output of type MutBytes.
    returns WarehouseRows.
    requires:
        updated.status == 0 otherwise updated.
    body:
        return WarehouseReplied(WarehouseMutationEncode(request, action, output), available).

operation WarehouseMutation:
    accepts fd of type i64.
    accepts found of type WarehouseRows.
    accepts request of type WarehouseRequest.
    accepts parameters of type Bytes.
    accepts action of type i64.
    accepts sql of type MutBytes.
    accepts scratch of type MutBytes.
    accepts output of type MutBytes.
    accepts empty of type MutBytes.
    returns WarehouseRows.
    effects: SystemCall.
    body:
        let locked = WarehouseLock(fd, found, request, parameters, action, sql, scratch, empty).
        let updated = WarehouseUpdate(fd, locked, request, parameters, action, sql, scratch, empty).
        return WarehouseMutationReply(updated, request, action, found.available, output).

# Length of the leading BE32-framed warehouse ID parameter (1..19 digits),
# 0 when the block is malformed; consumers never assume the fixed width.
operation WarehouseIdLength:
    accepts parameters of type Bytes.
    returns usize.
    requires:
        BinaryReadU32Be(parameters, usize(0)).status == 0 otherwise usize(0).
        BinaryReadU32Be(parameters, usize(0)).value >= 1 && BinaryReadU32Be(parameters, usize(0)).value <= 19 otherwise usize(0).
        usize(BinaryReadU32Be(parameters, usize(0)).value) <= len(parameters) - usize(4) otherwise usize(0).
    body:
        return usize(BinaryReadU32Be(parameters, usize(0)).value).

operation WarehouseWork:
    accepts fd of type i64.
    accepts request of type WarehouseRequest.
    accepts parameters of type Bytes.
    accepts action of type i64.
    accepts sql of type MutBytes.
    accepts scratch of type MutBytes.
    accepts output of type MutBytes.
    accepts empty of type MutBytes.
    returns WarehouseRows.
    requires:
        WarehouseIdLength(parameters) > usize(0) otherwise WarehouseRejectedRows(-71).
    effects: SystemCall.
    body:
        let parameter = slice(parameters, usize(0), WarehouseIdLength(parameters) + usize(4)).
        let begun = WarehouseQuery(fd, WarehouseBeginSql(action), 0, bytes(""), 0, bytes("BEGIN"), 0, u8(84), scratch, empty, 0).
        let found = WarehouseLookup(fd, begun, action, parameter, scratch, output).
        if action == 0:
            return WarehouseListing(fd, found, parameter, scratch, output).
        return WarehouseMutation(fd, found, request, parameters, action, sql, scratch, output, empty).

# One transaction per request on a fresh session; the fd closes on every path.
operation WarehouseTransaction:
    accepts fd of type i64.
    accepts request of type WarehouseRequest.
    accepts parameters of type Bytes.
    accepts action of type i64.
    accepts sql of type MutBytes.
    accepts scratch of type MutBytes.
    accepts output of type MutBytes.
    accepts empty of type MutBytes.
    returns WarehouseRows.
    effects: SystemCall.
    body:
        let prepared = WarehouseWork(fd, request, parameters, action, sql, scratch, output, empty).
        return WarehouseSettle(fd, prepared, scratch, output, empty).

# ---------------------------------------------------------------------------
# Database session and HTTP replies.
# ---------------------------------------------------------------------------

operation WarehouseKept:
    accepts fd of type i64.
    accepts ready of type i64.
    returns i64.
    effects: SystemCall.
    body:
        if ready < 0:
            LinuxClose(fd).
            return ready.
        return fd.

operation WarehouseLogin:
    accepts fd of type i64.
    accepts timeout of type i64.
    accepts scratch of type MutBytes.
    returns i64.
    requires:
        timeout >= 0 otherwise timeout.
    effects: SystemCall.
    body:
        return PgStartup(fd, WarehouseDatabaseUser(), WarehouseDatabaseName(), scratch).

operation WarehouseStartup:
    accepts fd of type i64.
    accepts scratch of type MutBytes.
    returns i64.
    requires:
        fd >= 0 otherwise fd.
    effects: SystemCall.
    body:
        return WarehouseKept(fd, WarehouseLogin(fd, LinuxSocketTimeouts(fd, 5), scratch)).

# Connected, timed-out and authenticated session fd, or negative (closed).
operation WarehouseConnect:
    accepts scratch of type MutBytes.
    returns i64.
    effects: SystemCall.
    body:
        return WarehouseStartup(LinuxUnixConnect(WarehouseDatabaseSocket(), scratch), scratch).

operation WarehouseSend:
    accepts client of type i64.
    accepts status of type i64.
    accepts written of type i64.
    accepts output of type MutBytes.
    accepts header of type MutBytes.
    returns i64.
    requires:
        written >= 0 otherwise written.
    effects: SystemCall.
    body:
        let body = view(output).
        let payload = slice(body, usize(0), usize(written)).
        let result = HttpWriteResponse(client, status, payload, header).
        borrow_end(payload).
        borrow_end(body).
        return result.

operation WarehouseError:
    accepts client of type i64.
    accepts failure of type WarehouseFailure.
    accepts output of type MutBytes.
    accepts header of type MutBytes.
    returns i64.
    effects: SystemCall.
    body:
        let written = ErrorReplyEncodeJson(ErrorReply(ErrorDetail(failure.code)), output).
        return WarehouseSend(client, failure.http, written, output, header).

# Error reply for a failed request read; other read failures just close.
operation WarehouseReadError:
    accepts client of type i64.
    accepts received of type i64.
    accepts output of type MutBytes.
    accepts header of type MutBytes.
    returns i64.
    requires:
        WarehouseReadFailure(received).http != 0 otherwise received.
    effects: SystemCall.
    body:
        return WarehouseError(client, WarehouseReadFailure(received), output, header).

operation WarehouseRespond:
    accepts client of type i64.
    accepts result of type WarehouseRows.
    accepts action of type i64.
    accepts output of type MutBytes.
    accepts header of type MutBytes.
    returns i64.
    effects: SystemCall.
    body:
        if result.status == 0:
            return WarehouseSend(client, 200, result.written, output, header).
        return WarehouseError(client, WarehouseOutcomeFailure(result.status, action), output, header).

# Exactly one arena mapping enters; Main owns Borrow discipline. Server owns
# client and arena. This callback owns only its database fd, closed by
# WarehouseTransaction on every path. Arena partition (2MiB): request 128KiB
# [0,131072), codec params 16KiB [131072,147456), SQL text 4KiB
# [147456,151552), PG scratch 64KiB [151552,217088), output reply
# [217088,218112+response_capacity), header 1KiB at top
# [capacity-1024,capacity). All loans are disjoint.
operation ServerDispatch:
    accepts client of type i64.
    accepts arena of type MutBytes.
    returns i64.
    requires:
        len(arena) >= 262144 otherwise -22.
        len(arena) <= 9223372036854775807 otherwise -22.
    effects: SystemCall.
    body:
        let capacity = len(arena).
        let httpBuf = slice_mut(arena, usize(0), usize(131072)).
        let codec = slice_mut(arena, usize(131072), usize(16384)).
        let sql = slice_mut(arena, usize(147456), usize(4096)).
        let scratch = slice_mut(arena, usize(151552), usize(65536)).
        let response_capacity = capacity - 218112.
        let output = slice_mut(arena, usize(217088), response_capacity).
        let header = slice_mut(arena, capacity - 1024, usize(1024)).
        let received = HttpReadRequest(client, httpBuf).
        if received < 0:
            return WarehouseReadError(client, received, output, header).
        let reqView = view(httpBuf).
        let http = slice(reqView, usize(0), usize(received)).
        let path = HttpPath(http).
        let method = HttpMethod(http).
        let action = WarehouseActionFor(path).
        let body_offset = HttpBodyOffset(http).
        let rejected = WarehouseRouteFailure(action, method, body_offset).
        borrow_end(path).
        borrow_end(method).
        if rejected.http != 0:
            return WarehouseError(client, rejected, output, header).
        let body = slice(http, usize(body_offset), len(http) - usize(body_offset)).
        let request = WarehouseDecodeRequest(body, action != 0, codec).
        let invalid = WarehouseDecodeFailure(request.status).
        if invalid.http != 0:
            return WarehouseError(client, invalid, output, header).
        let paramsView = view(codec).
        let parameters = slice(paramsView, request.parameter_offset, request.parameter_bytes).
        let fd = WarehouseConnect(scratch).
        if fd < 0:
            return WarehouseError(client, WarehouseFailure(503, "database_error"), output, header).
        let txEmpty = slice_mut(arena, usize(217088), usize(0)).
        let result = WarehouseTransaction(fd, request, parameters, action, sql, scratch, output, txEmpty).
        borrow_end(txEmpty).
        return WarehouseRespond(client, result, action, output, header).
