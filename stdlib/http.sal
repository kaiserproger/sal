use "bytes.sal".
use "linux/io.sal".

# HTTP/1.x, origin-form requests only. The caller owns arena loans and lifetimes.
# No allocation; no chunked transfer coding. Duplicate Content-Length is rejected.
#
# Rules live in operation headers next to accepts/returns: `requires: COND
# otherwise VALUE.` gates token classes, status/reason mapping and length
# validation; bodies only sequence parser scans, socket I/O and cursor
# framing. Header assembly threads one signed cursor through BytesAppend /
# BytesDecimalAt, so a negative errno propagates while the valid prefix stays
# partly written. Genuine parser and network state-machine branches stay in
# bodies; request-line rescans are never hoisted into contracts.
operation HttpToken:
    accepts value of type u8.
    returns bool.
    requires:
        value < 48 || value > 57 otherwise true.
        value < 65 || value > 90 otherwise true.
        value < 97 || value > 122 otherwise true.
    body:
        let punctuation = bytes("!#$%&'*+-.^_`|~").
        let mut index = usize(0).
        while index < len(punctuation):
            if value == byte(punctuation, index):
                return true.
            set index = index + 1.
        return false.

# Return the CR offset of a strictly valid request line, or -400.
operation HttpRequestLineEnd:
    accepts request of type Bytes.
    returns i64.
    body:
        let mut index = usize(0).
        while index < len(request):
            if byte(request, index) == 32:
                if index == 0:
                    return -400.
                let start = index + 1.
                if start >= len(request):
                    return -400.
                if byte(request, start) != 47:
                    return -400.
                set index = start.
                while index < len(request):
                    let value = byte(request, index).
                    if value == 32:
                        let version = index + 1.
                        if len(request) - version < 10:
                            return -400.
                        let protocol = slice(request, version, usize(8)).
                        if protocol != bytes("HTTP/1.0") && protocol != bytes("HTTP/1.1"):
                            return -400.
                        if byte(request, version + 8) != 13:
                            return -400.
                        if byte(request, version + 9) != 10:
                            return -400.
                        return i64(version + 8).
                    if value < 33:
                        return -400.
                    if value > 126:
                        return -400.
                    if value == 35:
                        return -400.
                    set index = index + 1.
                return -400.
            if HttpToken(byte(request, index)) == false:
                return -400.
            set index = index + 1.
        return -400.

# Search from start, including only positions with four available bytes.
operation HttpFindBodyOffset:
    accepts request of type Bytes.
    accepts start of type usize.
    returns i64.
    body:
        let mut index = start.
        while index <= len(request):
            if len(request) - index < 4:
                return -400.
            if byte(request, index) == 13 && byte(request, index + 1) == 10 && byte(request, index + 2) == 13 && byte(request, index + 3) == 10:
                return i64(index + 4).
            set index = index + 1.
        return -400.

# Delimiter lookup only, not whole-request validation. Missing delimiter is -400.
operation HttpBodyOffset:
    accepts request of type Bytes.
    returns i64.
    body:
        return HttpFindBodyOffset(request, usize(0)).

# Zero-copy method; an invalid or incomplete request line returns empty Bytes.
# Headers/body need not be present. A valid method is never empty.
operation HttpMethod:
    accepts request of type Bytes.
    returns Bytes from request.
    requires:
        HttpRequestLineEnd(request) >= 0 otherwise bytes("").
    body:
        let mut index = usize(0).
        while byte(request, index) != 32:
            set index = index + 1.
        return slice(request, usize(0), index).

# Zero-copy origin-form path, excluding query. Invalid lines return empty Bytes.
# A valid path starts with / and is never empty; headers are not validated here.
operation HttpPath:
    accepts request of type Bytes.
    returns Bytes from request.
    requires:
        HttpRequestLineEnd(request) >= 0 otherwise bytes("").
    body:
        let mut index = usize(0).
        while byte(request, index) != 32:
            set index = index + 1.
        let start = index + 1.
        set index = start.
        while byte(request, index) != 32:
            if byte(request, index) == 63:
                return slice(request, start, index - start).
            set index = index + 1.
        return slice(request, start, index - start).

# ASCII lowercase fold of one byte: A-Z shift down by 32, all else unchanged.
operation HttpLower:
    accepts value of type u8.
    returns u8.
    requires:
        value < 65 || value > 90 otherwise value + 32.
    body:
        return value.

# ASCII case-insensitive comparison against a lowercase header name.
operation HttpHeaderNameEquals:
    accepts name of type Bytes.
    accepts lower of type Bytes.
    returns bool.
    requires:
        len(name) == len(lower) otherwise false.
    body:
        let mut index = usize(0).
        while index < len(name):
            if HttpLower(byte(name, index)) != byte(lower, index):
                return false.
            set index = index + 1.
        return true.

# BytesParseDecimal result to Content-Length value: overflow is -413, any
# other parse failure is -400, nonnegatives pass through unchanged.
operation HttpLengthStatus:
    accepts parsed of type i64.
    returns i64.
    requires:
        parsed != -75 otherwise -413.
        parsed >= 0 otherwise -400.
    body:
        return parsed.

# Input ends immediately after CRLFCRLF. Validate all headers and framing.
operation HttpContentLength:
    accepts headers of type Bytes.
    returns i64.
    body:
        let line = HttpRequestLineEnd(headers).
        if line < 0:
            return -400.
        let mut index = usize(line) + 2.
        let mut contentLength = 0.
        let mut seenLength = false.
        while index < len(headers):
            if len(headers) - index < 2:
                return -400.
            if byte(headers, index) == 13:
                if byte(headers, index + 1) != 10:
                    return -400.
                if len(headers) - index != 2:
                    return -400.
                return contentLength.
            let nameStart = index.
            while true:
                if index >= len(headers):
                    return -400.
                let value = byte(headers, index).
                if value == 58:
                    break.
                if !HttpToken(value):
                    return -400.
                set index = index + 1.
            if index == nameStart:
                return -400.
            let name = slice(headers, nameStart, index - nameStart).
            set index = index + 1.
            let mut valueStart = index.
            while true:
                if index >= len(headers):
                    return -400.
                let value = byte(headers, index).
                if value == 13:
                    break.
                if (value < 32 && value != 9) || value == 127:
                    return -400.
                set index = index + 1.
            if len(headers) - index < 2:
                return -400.
            if byte(headers, index + 1) != 10:
                return -400.
            let mut valueEnd = index.
            set index = index + 2.
            if HttpHeaderNameEquals(name, bytes("transfer-encoding")):
                return -400.
            if !HttpHeaderNameEquals(name, bytes("content-length")):
                continue.
            if seenLength:
                return -400.
            set seenLength = true.
            while true:
                if valueStart == valueEnd:
                    return -400.
                let value = byte(headers, valueStart).
                if value != 32 && value != 9:
                    break.
                set valueStart = valueStart + 1.
            # Leading trim established a nonempty value with a nonspace first byte.
            while true:
                let value = byte(headers, valueEnd - 1).
                if value != 32 && value != 9:
                    break.
                set valueEnd = valueEnd - 1.
            let parsed = BytesParseDecimal(slice(headers, valueStart, valueEnd - valueStart)).
            let checked = HttpLengthStatus(parsed).
            if checked < 0:
                return checked.
            set contentLength = checked.
        return -400.

# Read one complete request into the caller arena loan, ignoring already-read
# pipelined bytes (close only). The returned count names the valid prefix;
# callers view it with view(buffer)/slice. Header limit includes request line
# and final CRLFCRLF; exactly 16384 is allowed. EOF before completion is -400;
# I/O errno propagates. Capacity exhaustion is -413, or -431 when the
# 16384-byte header bound is reached without a delimiter.
operation HttpReadRequest:
    accepts fd of type i64.
    accepts buffer of type MutBytes.
    returns i64.
    effects: SystemCall.
    requires:
        len(buffer) <= usize(9223372036854775807) otherwise -413.
    body:
        let capacity = len(buffer).
        let mut headerLimit = capacity.
        if headerLimit > 16384:
            set headerLimit = usize(16384).
        let mut used = usize(0).
        let mut bodyOffset = -400.
        while bodyOffset < 0:
            if used == headerLimit:
                if headerLimit == 16384:
                    return -431.
                return -413.
            let mut scan = usize(0).
            if used > 3:
                set scan = used - 3.
            let window = slice_mut(buffer, used, headerLimit - used).
            let received = LinuxReadInto(fd, window).
            borrow_end(window).
            if received < 0:
                return received.
            if received == 0:
                return -400.
            set used = used + usize(received).
            let current = view(buffer).
            let prefix = slice(current, usize(0), used).
            set bodyOffset = HttpFindBodyOffset(prefix, scan).
            borrow_end(current).
            borrow_end(prefix).
        let headerSize = usize(bodyOffset).
        let head = view(buffer).
        let headerView = slice(head, usize(0), headerSize).
        let contentLength = HttpContentLength(headerView).
        borrow_end(head).
        borrow_end(headerView).
        if contentLength < 0:
            return contentLength.
        if usize(contentLength) > capacity - headerSize:
            return -413.
        let total = headerSize + usize(contentLength).
        while used < total:
            let rest = slice_mut(buffer, used, total - used).
            let received = LinuxReadInto(fd, rest).
            borrow_end(rest).
            if received < 0:
                return received.
            if received == 0:
                return -400.
            set used = used + usize(received).
        return i64(total).

operation HttpStatusLine:
    accepts status of type i64.
    returns Bytes.
    requires:
        status != 200 otherwise bytes("HTTP/1.1 200 OK\r\n").
        status != 400 otherwise bytes("HTTP/1.1 400 Bad Request\r\n").
        status != 404 otherwise bytes("HTTP/1.1 404 Not Found\r\n").
        status != 405 otherwise bytes("HTTP/1.1 405 Method Not Allowed\r\n").
        status != 408 otherwise bytes("HTTP/1.1 408 Request Timeout\r\n").
        status != 409 otherwise bytes("HTTP/1.1 409 Conflict\r\n").
        status != 413 otherwise bytes("HTTP/1.1 413 Payload Too Large\r\n").
        status != 415 otherwise bytes("HTTP/1.1 415 Unsupported Media Type\r\n").
        status != 431 otherwise bytes("HTTP/1.1 431 Request Header Fields Too Large\r\n").
        status != 500 otherwise bytes("HTTP/1.1 500 Internal Server Error\r\n").
        status != 503 otherwise bytes("HTTP/1.1 503 Service Unavailable\r\n").
    body:
        return bytes("").

# Header scratch must not overlap body. Assemble headers before any network
# write. Unsupported status is -22; insufficient scratch is -28, with no
# network output. Scratch may be partly written on error. Response bodies are
# borrowed, not copied. The returned count names the valid header prefix.
# One signed cursor threads BytesAppend/BytesDecimalAt so each step
# propagates the first negative errno without an explicit error ladder.
operation HttpResponseHeader:
    accepts status of type i64.
    accepts length of type usize.
    accepts json of type bool.
    accepts scratch of type MutBytes.
    returns i64.
    requires:
        len(HttpStatusLine(status)) > 0 otherwise -22.
        length <= usize(9223372036854775807) otherwise -75.
    body:
        let statusLine = HttpStatusLine(status).
        let mut fields = bytes("Content-Type: text/plain; charset=utf-8\r\nContent-Length: ").
        if json:
            set fields = bytes("Content-Type: application/json\r\nContent-Length: ").
        let ending = bytes("\r\nConnection: close\r\n\r\n").
        let mut offset = BytesAppend(scratch, 0, statusLine).
        set offset = BytesAppend(scratch, offset, fields).
        set offset = BytesDecimalAt(scratch, offset, i64(length)).
        return BytesAppend(scratch, offset, ending).

operation HttpWriteFramed:
    accepts fd of type i64.
    accepts body of type Bytes.
    accepts header of type Bytes.
    returns i64.
    effects: SystemCall.
    body:
        let headerResult = LinuxWriteAll(fd, header).
        if headerResult < 0:
            return headerResult.
        let bodyResult = LinuxWriteAll(fd, body).
        if bodyResult < 0:
            return bodyResult.
        return 0.

operation HttpWriteResponse:
    accepts fd of type i64.
    accepts status of type i64.
    accepts body of type Bytes.
    accepts scratch of type MutBytes.
    returns i64.
    effects: SystemCall.
    body:
        let headerSize = HttpResponseHeader(status, len(body), true, scratch).
        if headerSize < 0:
            return headerSize.
        let head = view(scratch).
        let frame = slice(head, usize(0), usize(headerSize)).
        return HttpWriteFramed(fd, body, frame).

operation HttpWriteTextResponse:
    accepts fd of type i64.
    accepts status of type i64.
    accepts body of type Bytes.
    accepts scratch of type MutBytes.
    returns i64.
    effects: SystemCall.
    body:
        let headerSize = HttpResponseHeader(status, len(body), false, scratch).
        if headerSize < 0:
            return headerSize.
        let head = view(scratch).
        let frame = slice(head, usize(0), usize(headerSize)).
        return HttpWriteFramed(fd, body, frame).
