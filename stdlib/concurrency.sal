# Native SAL concurrency runtime: channels, select arbitration, threads.
#
# All synchronization/channel algorithms are SAL source in this file. The
# compiler only provides true machine/OS boundary intrinsics (atomic u32
# seq-cst words, unaligned-tolerant 64-bit loads/stores, operation_address,
# thread_launch via clone, and the zero-initialized concurrency_state
# static). No scheduler, no polling loops, no per-message heap allocation.
#
# Raw address-taking entries retain UnsafeMemory: a usize is not a checked
# channel/thread owner. The compiler's reserved SalConc wrappers contain the
# unsafe boundary after affine validation, so channel/send/receive/close,
# clone/drop/spawn/join/wait_for callers declare SystemCall only.
#
# Channel memory (one private anonymous mmap per channel, base = channel):
#   +0:  payload width in bytes (fixed per channel, >= 1).
#   +8:  capacity in messages (0 = rendezvous, > 0 = bounded ring).
#   +16: buffered message count (0 when a receiver is registered).
#   +24: ring head index (< capacity, or 0 when capacity is 0).
#   +32: ring tail index (< capacity, or 0 when capacity is 0).
#   +40: closed flag (0 open, 1 closed).
#   +48: owner refcount (explicit channel_clone/channel_drop; last drop unmaps).
#   +56: waiter list head (intrusive chain of select nodes, 0 = none).
#   +64: ring slots (capacity * width bytes; empty for rendezvous).
# Head/tail stay modulo capacity so checked SAL arithmetic can never
# overflow; the buffer product is range-checked once at creation.
#
# Select node (64 bytes in the compiler caller frame, stride 64):
#   +0:  channel, +8: direction (0 receive, 1 send), +16: payload pointer
#   (width-sized caller frame storage, receive storage zeroed by caller),
#   +24: shared completion address, +32: intrusive next link,
#   +40: outcome status (0 success, 1 closed), +48: local arm index
#   (runtime fills at entry), +56: linked flag (1 = on a channel list).
#
# Shared completion (stack C record, address shared by one SalSelect call):
#   +0: u32 atomic flag (0 waiting, 1 committed, 2 cancelled by timeout),
#   +8: winning local arm index, +16: winner status. Waiters sleep on +0
#   with futex WAIT expecting 0, so a commit between unlock and sleep
#   returns EAGAIN instead of losing the wakeup.
#
# Global gate (concurrency_state static, 16 bytes, 16-aligned):
#   +0: u32 spin/futex mutex (0 free, 1 held), +8: round-robin ticket.
# registration and every cleanup decision are atomic and no stale
# registered node is ever touched: a partner is eligible only when linked
# and its completion flag is still 0. Nodes from the same selection are
# excluded by completion address, and exactly one node per selection is
# ever committed (flag 0 -> 1 once).
# The ticket cycles 0 .. 2^32-1 (never overflowing checked arithmetic)
# and each multi-arm scan starts at ticket % arm count: ready-or-closed
# arms win in rotated source order, so multiple ready arms cannot
# source-order starve. The ticket advances exactly once per SalSelect
# invocation with more than one arm, under the gate on first entry;
# single-arm send/receive primitives and spurious retries never perturb
# rotation, so repeated ready selections cannot lock onto one parity.
#
# Futex usage: gate and select completions use PRIVATE ops (process-local
# addresses). Thread join uses shared op 0 because the kernel
# clear_child_tid wake is shared. Timed waits use WAIT_BITSET with an
# absolute CLOCK_MONOTONIC deadline, so EINTR/spurious wakes just re-loop
# with the same deadline; only a real ETIMEDOUT cancels the registration.
entity SelectCompletion:
    layout "C".
    has flag of type u32.
    has arm of type usize.
    has status of type usize.

entity FutexTime:
    layout "C".
    has seconds of type i64.
    has nanoseconds of type i64.

# Gate acquire: CAS 0 -> 1 wins; otherwise sleep until an unlock wakes us.
# A wake that arrives before we sleep surfaces as EAGAIN and we re-CAS.
operation ConcurrencyGateLock:
    accepts state of type usize.
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        while true:
            if atomic_cas(state, u32(0), u32(1)) == u32(0):
                return 0.
            ConcurrencyFutexWaitPrivate(state, u32(1)).
        return -1.

# Gate release: clear then wake exactly one waiter (a mutex needs one).
operation ConcurrencyGateUnlock:
    accepts state of type usize.
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        atomic_store(state, u32(0)).
        return syscall(202, i64(state), 129, 1, 0, 0, 0).

# Infinite private wait expecting the flag word to still hold expected.
operation ConcurrencyFutexWaitPrivate:
    accepts address of type usize.
    accepts expected of type u32.
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        return syscall(202, i64(address), 128, i64(expected), 0, 0, 0).

# Wake one waiter on a private completion word.
operation ConcurrencyFutexWakePrivate:
    accepts address of type usize.
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        return syscall(202, i64(address), 129, 1, 0, 0, 0).

# Absolute-deadline private wait on CLOCK_MONOTONIC. Returns 0 on wake,
# -4 EINTR, -11 EAGAIN (already committed), -110 ETIMEDOUT.
operation ConcurrencyFutexWaitDeadline:
    accepts address of type usize.
    accepts expected of type u32.
    accepts deadline of type usize.
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        return syscall(202, i64(address), 137, i64(expected), i64(deadline), 0, 4294967295).

# Monotonic clock sample into a 16-byte (seconds, nanoseconds) record.
operation ConcurrencyMonoNow:
    accepts output of type usize.
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        return syscall(228, 1, i64(output), 0, 0, 0, 0).

# Raw width-sized copy with no allocation: whole words then a byte tail.
operation ConcurrencyCopy:
    accepts destination of type usize.
    accepts source of type usize.
    accepts width of type usize.
    effects: UnsafeMemory.
    body:
        let words = width / 8.
        let mut index = usize(0).
        while index < words:
            store64(destination + index * 8, load64(source + index * 8)).
            set index = index + 1.
        let mut offset = words * 8.
        while offset < width:
            store8(destination + offset, load8(source + offset)).
            set offset = offset + 1.

# Append one message image at the ring tail: copy, advance tail modulo
# capacity, count + 1. The caller guarantees room (capacity > 0, count <
# capacity).
operation ConcurrencyRingPush:
    accepts channel of type usize.
    accepts source of type usize.
    effects: UnsafeMemory.
    body:
        let width = load64(channel).
        let tail = load64(channel + 32).
        ConcurrencyCopy(channel + 64 + tail * width, source, width).
        store64(channel + 32, (tail + 1) % load64(channel + 8)).
        store64(channel + 16, load64(channel + 16) + 1).

# Remove the oldest message image at the ring head: copy out, advance head
# modulo capacity, count - 1. The caller guarantees count > 0.
operation ConcurrencyRingPop:
    accepts channel of type usize.
    accepts destination of type usize.
    effects: UnsafeMemory.
    body:
        let width = load64(channel).
        let head = load64(channel + 24).
        ConcurrencyCopy(destination, channel + 64 + head * width, width).
        store64(channel + 24, (head + 1) % load64(channel + 8)).
        store64(channel + 16, load64(channel + 16) - 1).

# Intrusive unlink of one node from its channel waiter list. `slot` walks the
# link words (the list head, then each node's next link) so unlinking the
# head and an interior node is one store. A node that is not on the list is
# never found, which keeps cleanup idempotent.
operation ConcurrencyChannelUnlink:
    accepts channel of type usize.
    accepts node of type usize.
    effects: UnsafeMemory.
    body:
        let mut slot = channel + 56.
        while load64(slot) != 0 && load64(slot) != node:
            set slot = load64(slot) + 32.
        if load64(slot) == node:
            store64(slot, load64(node + 32)).
            store64(node + 32, usize(0)).
            store64(node + 56, usize(0)).

# Unlink every still-linked node of one selection. Idempotent, gate-held.
operation ConcurrencySelectCleanup:
    accepts nodes of type usize.
    accepts count of type usize.
    effects: UnsafeMemory.
    body:
        let mut index = usize(0).
        while index < count:
            let node = nodes + index * 64.
            if load64(node + 56) != 0:
                ConcurrencyChannelUnlink(load64(node), node).
            set index = index + 1.

# Link every unlinked node of one selection onto its channel waiter list.
operation ConcurrencySelectRegister:
    accepts nodes of type usize.
    accepts count of type usize.
    effects: UnsafeMemory.
    body:
        let mut index = usize(0).
        while index < count:
            let node = nodes + index * 64.
            if load64(node + 56) == 0:
                let channel = load64(node).
                store64(node + 32, load64(channel + 56)).
                store64(channel + 56, node).
                store64(node + 56, usize(1)).
            set index = index + 1.

# Stamp a selection's nodes at entry: shared completion, outcome 0, local arm
# index, not linked.
operation ConcurrencySelectPrepare:
    accepts nodes of type usize.
    accepts count of type usize.
    accepts completion of type usize.
    effects: UnsafeMemory.
    body:
        let mut mark = usize(0).
        while mark < count:
            let node = nodes + mark * 64.
            store64(node + 24, completion).
            store64(node + 40, usize(0)).
            store64(node + 48, mark).
            store64(node + 56, usize(0)).
            set mark = mark + 1.

# A node is a usable partner when it points the wanted way, belongs to a
# different selection, is still linked, and its completion still waits.
# Stale (cleaned-up or already-committed) nodes never qualify.
operation ConcurrencyNodeEligible:
    accepts node of type usize.
    accepts wanted of type usize.
    accepts self_completion of type usize.
    returns bool.
    effects: UnsafeMemory.
    body:
        return load64(node + 8) == wanted && load64(node + 24) != self_completion && load64(node + 56) != 0 && atomic_load(load64(node + 24)) == u32(0).

# First eligible opposite-direction waiter on a channel, or 0.
operation ConcurrencyChannelFindPartner:
    accepts channel of type usize.
    accepts direction of type usize.
    accepts self_completion of type usize.
    returns usize.
    effects: UnsafeMemory.
    body:
        let wanted = usize(1) - direction.
        let mut current = load64(channel + 56).
        while current != 0 && ConcurrencyNodeEligible(current, wanted, self_completion) == false:
            set current = load64(current + 32).
        return current.

# Mapped address, or 0 when the mmap result is a negative errno.
operation ConcurrencyAddress:
    accepts mapped of type i64.
    returns usize.
    requires:
        mapped >= 0 otherwise usize(0).
    body:
        return usize(mapped).

# Raw mmap helper for compiler-owned spawn contexts. Returns 0 on failure.
operation SalAlloc:
    accepts size of type usize.
    returns usize.
    effects: SystemCall, UnsafeMemory.
    requires:
        size != 0 otherwise usize(0).
    body:
        return ConcurrencyAddress(syscall(9, 0, i64(size), 3, 34, -1, 0)).

# Raw munmap helper for compiler-owned spawn contexts.
operation SalFree:
    accepts address of type usize.
    accepts size of type usize.
    effects: SystemCall, UnsafeMemory.
    body:
        if address != 0 && size != 0:
            syscall(11, i64(address), i64(size), 0, 0, 0, 0).

# Header of a fresh channel mapping: width, capacity, refcount 1. Every
# other header word (count, head, tail, closed, waiters) starts zero from
# the anonymous mapping. A failed mapping (channel 0) stays 0.
operation ConcurrencyChannelInit:
    accepts channel of type usize.
    accepts capacity of type usize.
    accepts width of type usize.
    returns usize.
    effects: UnsafeMemory.
    requires:
        channel != 0 otherwise usize(0).
    body:
        store64(channel, width).
        store64(channel + 8, capacity).
        store64(channel + 48, usize(1)).
        return channel.

# Create a channel: one zeroed mmap holding the header plus a
# capacity * width ring. Returns 0 on invalid sizes or mmap failure.
operation SalChannelNew:
    accepts capacity of type usize.
    accepts width of type usize.
    returns usize.
    effects: SystemCall, UnsafeMemory.
    requires:
        width != 0 otherwise usize(0).
        capacity == 0 || width <= (usize(4611686018427387903) - 64) / capacity otherwise usize(0).
    body:
        return ConcurrencyChannelInit(SalAlloc(64 + capacity * width), capacity, width).

# Explicit ownership duplicate: bump the refcount under the gate.
operation SalChannelClone:
    accepts channel of type usize.
    returns usize.
    effects: SystemCall, UnsafeMemory.
    body:
        let state = concurrency_state().
        ConcurrencyGateLock(state).
        store64(channel + 48, load64(channel + 48) + 1).
        ConcurrencyGateUnlock(state).
        return channel.

# Explicit ownership release; the last drop unmaps the ring exactly once.
operation SalChannelDrop:
    accepts channel of type usize.
    effects: SystemCall, UnsafeMemory.
    body:
        let state = concurrency_state().
        ConcurrencyGateLock(state).
        let refs = load64(channel + 48).
        if refs == 1:
            let total = 64 + load64(channel + 8) * load64(channel).
            store64(channel + 48, usize(0)).
            ConcurrencyGateUnlock(state).
            syscall(11, i64(channel), i64(total), 0, 0, 0, 0).
        else:
            if refs > 1:
                store64(channel + 48, refs - 1).
            ConcurrencyGateUnlock(state).

# Commit a selection's completion for the arm owning `node`: outcome status
# on the node, winning arm and status on the shared completion, then the
# atomic 0 -> 1 flag flip that publishes them (always before any wake).
operation ConcurrencyCompletionCommit:
    accepts node of type usize.
    accepts completion of type usize.
    accepts arm of type usize.
    accepts status of type usize.
    effects: UnsafeMemory.
    body:
        store64(node + 40, status).
        store64(completion + 8, arm).
        store64(completion + 16, status).
        atomic_store(completion, u32(1)).

# Resolve one blocked partner node: commit its selection with `status`,
# take it off the channel list, then wake the sleeping select.
operation ConcurrencyWaiterWake:
    accepts channel of type usize.
    accepts node of type usize.
    accepts status of type usize.
    effects: SystemCall, UnsafeMemory.
    body:
        let waiter = load64(node + 24).
        ConcurrencyCompletionCommit(node, waiter, load64(node + 48), status).
        ConcurrencyChannelUnlink(channel, node).
        ConcurrencyFutexWakePrivate(waiter).

# Close one still-waiting node: a blocked send fails closed; a blocked
# receive drains one buffered value (success) or else fails closed.
operation ConcurrencyChannelCloseWaiter:
    accepts channel of type usize.
    accepts node of type usize.
    effects: SystemCall, UnsafeMemory.
    body:
        if atomic_load(load64(node + 24)) == u32(0):
            let mut status = usize(1).
            if load64(node + 8) != 1 && load64(channel + 16) != 0:
                ConcurrencyRingPop(channel, load64(node + 16)).
                set status = usize(0).
            ConcurrencyWaiterWake(channel, node, status).

# Close marks the channel, immediately fails every blocked send with
# closed status, and commits every still-waiting blocked receiver under
# the gate: buffered values drain into the receiver payload (success)
# before later receivers observe closed-empty. Commit (flag 0 -> 1)
# always precedes the wake, so a close racing the receiver's unlock/sleep
# gap surfaces as EAGAIN instead of a lost wakeup. A second close fails.
operation SalChannelClose:
    accepts channel of type usize.
    returns bool.
    effects: SystemCall, UnsafeMemory.
    body:
        let state = concurrency_state().
        ConcurrencyGateLock(state).
        if load64(channel + 40) != 0:
            ConcurrencyGateUnlock(state).
            return false.
        store64(channel + 40, usize(1)).
        let mut current = load64(channel + 56).
        while current != 0:
            let next = load64(current + 32).
            ConcurrencyChannelCloseWaiter(channel, current).
            set current = next.
        ConcurrencyGateUnlock(state).
        return true.

# One scan result: the ready arm (`arm`, or the arm count when none), its
# direction, outcome status (0 success, 1 closed) and rendezvous partner.
entity ConcurrencySelectProbe:
    layout "C".
    has found of type bool.
    has send of type bool.
    has status of type usize.
    has partner of type usize.
    has arm of type usize.

# Send readiness: closed fails, a waiting receiver pairs, else buffer room.
operation ConcurrencySendProbe:
    accepts channel of type usize.
    accepts completion of type usize.
    accepts arm of type usize.
    returns ConcurrencySelectProbe.
    effects: UnsafeMemory.
    body:
        if load64(channel + 40) != 0:
            return ConcurrencySelectProbe(true, true, usize(1), usize(0), arm).
        let mate = ConcurrencyChannelFindPartner(channel, usize(1), completion).
        if mate != 0:
            return ConcurrencySelectProbe(true, true, usize(0), mate, arm).
        return ConcurrencySelectProbe(load64(channel + 8) != 0 && load64(channel + 16) < load64(channel + 8), true, usize(0), usize(0), arm).

# Receive readiness: buffered values pop first (pulling a waiting sender
# into the freed slot), then closed fails, else a waiting sender pairs.
operation ConcurrencyReceiveProbe:
    accepts channel of type usize.
    accepts completion of type usize.
    accepts arm of type usize.
    returns ConcurrencySelectProbe.
    effects: UnsafeMemory.
    body:
        if load64(channel + 16) != 0:
            return ConcurrencySelectProbe(true, false, usize(0), ConcurrencyChannelFindPartner(channel, usize(0), completion), arm).
        if load64(channel + 40) != 0:
            return ConcurrencySelectProbe(true, false, usize(1), usize(0), arm).
        let mate = ConcurrencyChannelFindPartner(channel, usize(0), completion).
        return ConcurrencySelectProbe(mate != 0, false, usize(0), mate, arm).

operation ConcurrencyArmProbe:
    accepts nodes of type usize.
    accepts arm of type usize.
    accepts completion of type usize.
    returns ConcurrencySelectProbe.
    effects: UnsafeMemory.
    body:
        let node = nodes + arm * 64.
        if load64(node + 8) == 1:
            return ConcurrencySendProbe(load64(node), completion, arm).
        return ConcurrencyReceiveProbe(load64(node), completion, arm).

# Scan every arm once from `start` in rotated source order; the first ready
# or closed arm wins. found == false carries arm == count.
operation ConcurrencySelectScan:
    accepts nodes of type usize.
    accepts count of type usize.
    accepts start of type usize.
    accepts completion of type usize.
    returns ConcurrencySelectProbe.
    effects: UnsafeMemory.
    body:
        let mut scan = usize(0).
        while scan < count:
            let probe = ConcurrencyArmProbe(nodes, (start + scan) % count, completion).
            if probe.found:
                return probe.
            set scan = scan + 1.
        return ConcurrencySelectProbe(false, false, usize(0), usize(0), count).

# Send commit: hand the payload to a waiting receiver, else buffer it.
operation ConcurrencySelectSend:
    accepts channel of type usize.
    accepts payload of type usize.
    accepts partner of type usize.
    effects: SystemCall, UnsafeMemory.
    body:
        if partner != 0:
            ConcurrencyCopy(load64(partner + 16), payload, load64(channel)).
            ConcurrencyWaiterWake(channel, partner, usize(0)).
        else:
            ConcurrencyRingPush(channel, payload).

# Receive commit: pop the buffer (pulling one waiting sender into the freed
# slot to preserve FIFO), else take directly from the rendezvous sender.
operation ConcurrencySelectReceive:
    accepts channel of type usize.
    accepts payload of type usize.
    accepts partner of type usize.
    effects: SystemCall, UnsafeMemory.
    body:
        if load64(channel + 16) != 0:
            ConcurrencyRingPop(channel, payload).
            if partner != 0:
                ConcurrencyRingPush(channel, load64(partner + 16)).
                ConcurrencyWaiterWake(channel, partner, usize(0)).
        else:
            ConcurrencyCopy(payload, load64(partner + 16), load64(channel)).
            ConcurrencyWaiterWake(channel, partner, usize(0)).

# Apply the winning arm: transfer data (success only), then publish the
# selection's completion.
operation ConcurrencySelectCommit:
    accepts nodes of type usize.
    accepts completion of type usize.
    accepts probe of type ConcurrencySelectProbe.
    effects: SystemCall, UnsafeMemory.
    body:
        let win = nodes + probe.arm * 64.
        if probe.status == 0 && probe.send:
            ConcurrencySelectSend(load64(win), load64(win + 16), probe.partner).
        if probe.status == 0 && probe.send == false:
            ConcurrencySelectReceive(load64(win), load64(win + 16), probe.partner).
        ConcurrencyCompletionCommit(win, completion, probe.arm, probe.status).

# Rotation start: a multi-arm selection takes the global ticket once (under
# the gate), advancing it modulo 2^32 so checked arithmetic never overflows;
# a single arm never perturbs rotation.
operation ConcurrencyTicketTake:
    accepts ticket_word of type usize.
    accepts count of type usize.
    returns usize.
    effects: UnsafeMemory.
    requires:
        count > 1 otherwise usize(0).
    body:
        let ticket = load64(ticket_word).
        store64(ticket_word, (ticket + 1) % 4294967296).
        return ticket % count.

# Absolute CLOCK_MONOTONIC deadline `timeout` milliseconds from now stored
# into the (seconds, nanoseconds) record at `clock`. Returns the record
# address, or 0 when the selection has no deadline (timeout <= 0).
operation ConcurrencyDeadlineSet:
    accepts clock of type usize.
    accepts timeout of type isize.
    returns usize.
    effects: SystemCall, UnsafeMemory.
    requires:
        timeout > 0 otherwise usize(0).
    body:
        ConcurrencyMonoNow(clock).
        let span = usize(timeout).
        let nanoseconds = i64(load64(clock + 8)) + i64(span % 1000 * 1000000).
        let seconds = i64(load64(clock)) + i64(span / 1000) + nanoseconds / 1000000000.
        store64(clock, usize(seconds)).
        store64(clock + 8, usize(nanoseconds % 1000000000)).
        return clock.

# Sleep on the completion word expecting 0: forever without a deadline,
# else until the absolute deadline.
operation ConcurrencySelectSleep:
    accepts completion of type usize.
    accepts deadline of type usize.
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        if deadline == 0:
            return ConcurrencyFutexWaitPrivate(completion, u32(0)).
        return ConcurrencyFutexWaitDeadline(completion, u32(0), deadline).

# Leave a gate-held selection: unlink its nodes, release the gate, report.
operation ConcurrencySelectLeave:
    accepts nodes of type usize.
    accepts count of type usize.
    accepts gate of type usize.
    accepts result of type usize.
    returns usize.
    effects: SystemCall, UnsafeMemory.
    body:
        ConcurrencySelectCleanup(nodes, count).
        ConcurrencyGateUnlock(gate).
        return result.

# Atomic multi-arm select and the blocking primitive for single
# send/receive. timeout -1 blocks forever, 0 is otherwise-fallback,
# positive is milliseconds. Returns the winning arm index, or count for
# fallback. Each channel width is used for its own node payload copies;
# arms never assume a shared width. Ready-or-closed arms commit in
# ticket-rotated source order: buffered sends enqueue when space remains,
# buffered receives pop (pulling one waiting sender into the freed slot to
# preserve FIFO), rendezvous arms pair directly, and closed sends fail
# while closed receives drain before failing. The rotation ticket advances
# exactly once per SalSelect invocation with more than one arm (gate-held
# on first entry below): single-arm send/receive and spurious retries
# never perturb rotation.
#
# The gate is held at the top of every loop pass: taken before the loop,
# and retaken straight after every sleep. A woken waiter therefore never
# reads its frame before the committing thread has released the gate.
operation SalSelect:
    accepts nodes of type usize.
    accepts count of type usize.
    accepts timeout of type isize.
    returns usize.
    effects: SystemCall, UnsafeMemory.
    requires:
        count > 0 otherwise usize(0).
    body:
        let gate = concurrency_state().
        let done = SelectCompletion(u32(0), usize(0), usize(0)).
        let completion = address(done).
        ConcurrencySelectPrepare(nodes, count, completion).
        let clock = FutexTime(i64(0), i64(0)).
        let deadline = ConcurrencyDeadlineSet(address(clock), timeout).
        ConcurrencyGateLock(gate).
        let start = ConcurrencyTicketTake(gate + 8, count).
        while true:
            if atomic_load(completion) != u32(0):
                return ConcurrencySelectLeave(nodes, count, gate, load64(completion + 8)).
            let probe = ConcurrencySelectScan(nodes, count, start, completion).
            if probe.found:
                ConcurrencySelectCommit(nodes, completion, probe).
                return ConcurrencySelectLeave(nodes, count, gate, probe.arm).
            if timeout == 0:
                return ConcurrencySelectLeave(nodes, count, gate, count).
            ConcurrencySelectRegister(nodes, count).
            ConcurrencyGateUnlock(gate).
            let waited = ConcurrencySelectSleep(completion, deadline).
            ConcurrencyGateLock(gate).
            if waited == -110 && atomic_load(completion) == u32(0):
                atomic_store(completion, u32(2)).
                return ConcurrencySelectLeave(nodes, count, gate, count).
        return count.

# Guard the stack mapping: PROT_NONE on its lowest page. No stack (0, from an
# earlier failure) passes through; a guard failure unmaps the stack and
# reports 0.
operation ConcurrencyThreadGuard:
    accepts base of type usize.
    returns usize.
    effects: SystemCall, UnsafeMemory.
    requires:
        base != 0 otherwise usize(0).
    body:
        if syscall(10, i64(base), 4096, 0, 0, 0, 0) != 0:
            SalFree(base, usize(8388608)).
            return usize(0).
        return base.

# Map the 8 MiB thread stack and guard it. No control block (0) maps nothing.
operation ConcurrencyThreadStack:
    accepts control of type usize.
    returns usize.
    effects: SystemCall, UnsafeMemory.
    requires:
        control != 0 otherwise usize(0).
    body:
        return ConcurrencyThreadGuard(SalAlloc(usize(8388608))).

# Record the stack in the control block and clone the child onto its top.
# No stack (0) is the failure status -1.
operation ConcurrencyThreadLaunch:
    accepts control of type usize.
    accepts base of type usize.
    accepts entry of type usize.
    accepts argument of type usize.
    returns i64.
    effects: SystemCall, UnsafeMemory.
    requires:
        base != 0 otherwise -1.
    body:
        store64(control + 16, base).
        store64(control + 24, usize(8388608)).
        return thread_launch(entry, argument, base + 8388608, control).

# Spawn a real OS thread: one page control block {tid u32 at +0,
# result i64 at +8, stack base at +16, stack size at +24} plus an 8 MiB
# stack whose lowest page is a PROT_NONE guard. The child runs
# entry(argument) via thread_launch (clone with VM/FS/FILES/SIGHAND/
# THREAD/SYSVSEM/PARENT_SETTID/CHILD_SETTID/CHILD_CLEARTID), stores its
# i64 result at control + 8, and exits; the kernel then zeroes control
# + 0 and issues the shared clear_tid wake the join waits for. Each step
# passes an earlier failure (0) through unchanged; any failure unmaps
# whatever was mapped (SalFree skips the zero addresses) and reports spawn
# failure (0). Returns the control address as the thread handle.
operation SalThreadSpawn:
    accepts entry of type usize.
    accepts argument of type usize.
    returns usize.
    effects: SystemCall, UnsafeMemory.
    body:
        let control = SalAlloc(usize(4096)).
        let base = ConcurrencyThreadStack(control).
        let launched = ConcurrencyThreadLaunch(control, base, entry, argument).
        if launched < 0:
            SalFree(base, usize(8388608)).
            SalFree(control, usize(4096)).
            return usize(0).
        return control.

# Reinterpret a stored 64-bit word as signed i64 without a trapping
# usize -> i64 cast, so negative worker results survive (high bit set means
# value - (2^64 - bits)).
operation ConcurrencyBitsToI64:
    accepts bits of type usize.
    returns i64.
    requires:
        bits / 4294967296 < 2147483648 otherwise (i64(bits / 4294967296) - 4294967296) * 4294967296 + i64(bits % 4294967296).
    body:
        return i64(bits).

# Join waits on the shared clear_tid word (shared op 0, never private:
# the kernel wake is shared), reclaims stack, guard, control and handle
# storage once the child is gone, then reinterprets the stored word.
operation SalThreadJoin:
    accepts thread of type usize.
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        let control = thread.
        let base = load64(control + 16).
        let size = load64(control + 24).
        let mut tid = atomic_load(control).
        while tid != u32(0):
            syscall(202, i64(control), 0, i64(tid), 0, 0, 0).
            set tid = atomic_load(control).
        let bits = load64(control + 8).
        syscall(11, i64(base), i64(size), 0, 0, 0, 0).
        syscall(11, i64(control), 4096, 0, 0, 0, 0).
        return ConcurrencyBitsToI64(bits).
