# Native JSON parsing is allocation-free. Offsets and counts are bytes.
# -22 = malformed input, -28 = insufficient output loan, -75 = overflow.
# Safe writers take MutBytes loans; lengths come from loans, never claimed
# capacities. No trailing NUL. The caller owns arena partition loans and keeps
# decoded payloads disjoint from unread input. Input bounds are header
# requires clauses carrying the same error otherwise values.

use "bytes.sal".
use "text.sal".

# An endpoint start == len(input) is valid; only space, tab, CR and LF are skipped.
operation JsonWhitespaceEnd:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    requires:
        start <= len(input) otherwise -22.
    body:
        let mut offset = start.
        while offset < len(input):
            let ch = byte(input, offset).
            if ch != 32 && ch != 9 && ch != 10 && ch != 13:
                return i64(offset).
            set offset = offset + 1.
        return i64(offset).

operation JsonDigit:
    accepts ch of type u8.
    returns bool.
    body:
        return ch >= 48 && ch <= 57.

operation JsonHexQuad:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    requires:
        start <= len(input) otherwise -22.
        len(input) - start >= usize(4) otherwise -22.
    body:
        let mut value = 0.
        let mut index = usize(0).
        while index < 4:
            let digit = BytesHexDigit(byte(input, start + index)).
            if digit < 0:
                return -22.
            set value = value * 16 + digit.
            set index = index + 1.
        return value.

operation JsonScalarWidth:
    accepts scalar of type i64.
    returns usize.
    requires:
        scalar >= 128 otherwise usize(1).
        scalar >= 2048 otherwise usize(2).
        scalar >= 65536 otherwise usize(3).
    body:
        return usize(4).

# Decode through the shared strict UTF-8 scanner; an end step is not a scalar.
operation JsonUtf8Scalar:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    body:
        return JsonUtf8Value(TextNext(input, start)).

operation JsonUtf8Value:
    accepts step of type TextStep.
    returns i64.
    requires:
        step.status == 0 otherwise -22.
    body:
        return step.scalar.

# start is the backslash, not the u. Paired UTF-16 escapes form one scalar.
operation JsonEscapeScalar:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    requires:
        start < len(input) otherwise -22.
        len(input) - start >= usize(2) otherwise -22.
        byte(input, start + 1) == 117 otherwise JsonSimpleEscape(byte(input, start + 1)).
    body:
        return JsonUnicodeEscape(input, start, JsonHexQuad(input, start + 2)).

# The JSON escape alphabet is a mapping, not a scanner decision tree.
operation JsonSimpleEscape:
    accepts ch of type u8.
    returns i64.
    requires:
        ch != 34 otherwise 34.
        ch != 92 otherwise 92.
        ch != 47 otherwise 47.
        ch != 98 otherwise 8.
        ch != 102 otherwise 12.
        ch != 110 otherwise 10.
        ch != 114 otherwise 13.
        ch != 116 otherwise 9.
    body:
        return -22.

# A non-surrogate quad is complete; a high surrogate requires its low pair.
operation JsonUnicodeEscape:
    accepts input of type Bytes.
    accepts start of type usize.
    accepts high of type i64.
    returns i64.
    requires:
        high >= 0 otherwise -22.
        start <= len(input) otherwise -22.
        high < 56320 || high > 57343 otherwise -22.
        high >= 55296 otherwise high.
        high <= 56319 otherwise high.
        len(input) - start >= usize(12) otherwise -22.
        byte(input, start + 6) == 92 otherwise -22.
        byte(input, start + 7) == 117 otherwise -22.
    body:
        return JsonSurrogatePair(high, JsonHexQuad(input, start + 8)).

operation JsonSurrogatePair:
    accepts high of type i64.
    accepts low of type i64.
    returns i64.
    requires:
        low >= 56320 otherwise -22.
        low <= 57343 otherwise -22.
    body:
        return 65536 + (high - 55296) * 1024 + low - 56320.

operation JsonCharacterScalar:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    requires:
        start < len(input) otherwise -22.
        byte(input, start) >= 32 otherwise -22.
    body:
        let ch = byte(input, start).
        if ch == 92:
            return JsonEscapeScalar(input, start).
        return JsonUtf8Scalar(input, start).

# Called only after JsonCharacterScalar succeeded at start.
operation JsonCharacterWidth:
    accepts input of type Bytes.
    accepts start of type usize.
    accepts scalar of type i64.
    returns usize.
    requires:
        byte(input, start) == 92 otherwise JsonScalarWidth(scalar).
        byte(input, start + 1) == 117 otherwise usize(2).
        scalar < 65536 otherwise usize(12).
    body:
        return usize(6).

# start must name an opening quote; success excludes any following bytes.
operation JsonStringEnd:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    requires:
        start < len(input) otherwise -22.
        byte(input, start) == 34 otherwise -22.
    body:
        let mut offset = start + 1.
        while offset < len(input):
            if byte(input, offset) == 34:
                return i64(offset + 1).
            let scalar = JsonCharacterScalar(input, offset).
            if scalar < 0:
                return -22.
            set offset = offset + JsonCharacterWidth(input, offset, scalar).
        return -22.

operation JsonDigitsEnd:
    accepts input of type Bytes.
    accepts start of type usize.
    returns usize.
    body:
        let mut offset = start.
        while offset < len(input):
            if JsonDigit(byte(input, offset)) == false:
                return offset.
            set offset = offset + 1.
        return offset.

operation JsonNumberEnd:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    requires:
        start < len(input) otherwise -22.
    body:
        let mut offset = start.
        if byte(input, offset) == 45:
            set offset = offset + 1.
        if offset == len(input):
            return -22.
        if byte(input, offset) == 48:
            set offset = offset + 1.
            if offset < len(input) && JsonDigit(byte(input, offset)):
                return -22.
        else:
            if JsonDigit(byte(input, offset)) == false:
                return -22.
            set offset = JsonDigitsEnd(input, offset).
        if offset < len(input) && byte(input, offset) == 46:
            set offset = offset + 1.
            let digits = offset.
            set offset = JsonDigitsEnd(input, offset).
            if offset == digits:
                return -22.
        if offset < len(input):
            let ch = byte(input, offset).
            if ch == 101 || ch == 69:
                set offset = offset + 1.
                if offset < len(input):
                    let sign = byte(input, offset).
                    if sign == 43 || sign == 45:
                        set offset = offset + 1.
                let digits = offset.
                set offset = JsonDigitsEnd(input, offset).
                if offset == digits:
                    return -22.
        return i64(offset).

# Each value consumes one level, including scalar values. Budget zero rejects.
# Only containers recurse; the caller's explicit decreasing budget bounds stack use.
# Leading whitespace is skipped. Success ends at the value, not trailing bytes.
# Object keys must be strings; duplicate-key policy belongs to the application.
operation JsonValueEnd:
    accepts input of type Bytes.
    accepts start of type usize.
    accepts depth of type usize.
    returns i64.
    requires:
        depth > usize(0) otherwise -22.
        start <= len(input) otherwise -22.
    body:
        let skipped = JsonWhitespaceEnd(input, start).
        let mut offset = usize(skipped).
        if offset == len(input):
            return -22.
        let ch = byte(input, offset).
        if ch == 34:
            return JsonStringEnd(input, offset).
        if ch == 116:
            if BytesStartsWith(slice(input, offset, len(input) - offset), bytes("true")):
                return i64(offset + 4).
            return -22.
        if ch == 102:
            if BytesStartsWith(slice(input, offset, len(input) - offset), bytes("false")):
                return i64(offset + 5).
            return -22.
        if ch == 110:
            if BytesStartsWith(slice(input, offset, len(input) - offset), bytes("null")):
                return i64(offset + 4).
            return -22.
        let mut closing = u8(0).
        if ch == 91:
            set closing = u8(93).
        if ch == 123:
            set closing = u8(125).
        if closing == 0:
            return JsonNumberEnd(input, offset).
        set offset = usize(JsonWhitespaceEnd(input, offset + 1)).
        if offset == len(input):
            return -22.
        if byte(input, offset) == closing:
            return i64(offset + 1).
        while offset < len(input):
            if ch == 123:
                let key = JsonStringEnd(input, offset).
                if key < 0:
                    return -22.
                set offset = usize(JsonWhitespaceEnd(input, usize(key))).
                if offset == len(input):
                    return -22.
                if byte(input, offset) != 58:
                    return -22.
                set offset = offset + 1.
            let value = JsonValueEnd(input, offset, depth - 1).
            if value < 0:
                return -22.
            set offset = usize(JsonWhitespaceEnd(input, usize(value))).
            if offset == len(input):
                return -22.
            if byte(input, offset) == closing:
                return i64(offset + 1).
            if byte(input, offset) != 44:
                return -22.
            set offset = usize(JsonWhitespaceEnd(input, offset + 1)).
            if offset == len(input):
                return -22.
            if byte(input, offset) == closing:
                return -22.
        return -22.

operation JsonValidate:
    accepts input of type Bytes.
    returns bool.
    body:
        let end = JsonValueEnd(input, usize(0), usize(64)).
        if end < 0:
            return false.
        return JsonWhitespaceEnd(input, usize(end)) == i64(len(input)).

operation JsonUnsigned:
    accepts input of type Bytes.
    returns i64.
    requires:
        len(input) > usize(0) otherwise -22.
        len(input) <= usize(1) || byte(input, usize(0)) != 48 otherwise -22.
    body:
        # Validate the entire grammar before reporting numerical overflow.
        let mut index = usize(0).
        while index < len(input):
            if JsonDigit(byte(input, index)) == false:
                return -22.
            set index = index + 1.
        return BytesParseDecimal(input).

operation JsonEmitScalar:
    accepts scalar of type i64.
    accepts output of type MutBytes.
    returns i64.
    body:
        let width = JsonScalarWidth(scalar).
        if len(output) < width:
            return -28.
        if width == 1:
            put(output, usize(0), u8(scalar)).
        if width == 2:
            put(output, usize(0), u8(192 + scalar / 64)).
            put(output, usize(1), u8(128 + scalar % 64)).
        if width == 3:
            put(output, usize(0), u8(224 + scalar / 4096)).
            put(output, usize(1), u8(128 + scalar / 64 % 64)).
            put(output, usize(2), u8(128 + scalar % 64)).
        if width == 4:
            put(output, usize(0), u8(240 + scalar / 262144)).
            put(output, usize(1), u8(128 + scalar / 4096 % 64)).
            put(output, usize(2), u8(128 + scalar / 64 % 64)).
            put(output, usize(3), u8(128 + scalar % 64)).
        return i64(width).

# One-pass string decoding with both output count and source cursor.
# On failure output may hold a prefix; only status 0 makes it a full string.
entity JsonStringRead:
    layout "C".
    has status of type i64.
    has written of type usize.
    has read_end of type usize.

operation JsonDecodeStringAt:
    accepts input of type Bytes.
    accepts start of type usize.
    accepts output of type MutBytes.
    returns JsonStringRead.
    requires:
        start < len(input) otherwise JsonStringRead(-22, usize(0), start).
        byte(input, start) == 34 otherwise JsonStringRead(-22, usize(0), start).
    body:
        let mut offset = start + 1.
        let mut written = usize(0).
        while offset < len(input):
            if byte(input, offset) == 34:
                return JsonStringRead(0, written, offset + 1).
            let scalar = JsonCharacterScalar(input, offset).
            if scalar < 0:
                return JsonStringRead(-22, written, offset).
            let window = slice_mut(output, written, len(output) - written).
            let count = JsonEmitScalar(scalar, window).
            borrow_end(window).
            if count < 0:
                return JsonStringRead(count, written, offset).
            set written = written + usize(count).
            set offset = offset + JsonCharacterWidth(input, offset, scalar).
        return JsonStringRead(-22, written, offset).

# Count-only decoding when the caller does not need the following cursor.
operation JsonDecodeString:
    accepts input of type Bytes.
    accepts start of type usize.
    accepts output of type MutBytes.
    returns i64.
    body:
        let decoded = JsonDecodeStringAt(input, start, output).
        if decoded.status != 0:
            return decoded.status.
        return i64(decoded.written).

operation JsonWriteString:
    accepts value of type Bytes.
    accepts output of type MutBytes.
    returns i64.
    requires:
        len(output) > usize(0) otherwise -28.
    body:
        put(output, usize(0), u8(34)).
        let mut written = usize(1).
        let mut offset = usize(0).
        while offset < len(value):
            let scalar = JsonUtf8Scalar(value, offset).
            if scalar < 0:
                return -22.
            set offset = offset + JsonScalarWidth(scalar).
            if scalar < 32:
                if len(output) - written < 6:
                    return -28.
                put(output, written, u8(92)).
                put(output, written + 1, u8(117)).
                put(output, written + 2, u8(48)).
                put(output, written + 3, u8(48)).
                put(output, written + 4, byte(bytes("0123456789abcdef"), usize(scalar / 16))).
                put(output, written + 5, byte(bytes("0123456789abcdef"), usize(scalar % 16))).
                set written = written + 6.
                continue.
            if scalar == 34 || scalar == 92:
                if len(output) - written < 2:
                    return -28.
                put(output, written, u8(92)).
                put(output, written + 1, u8(scalar)).
                set written = written + 2.
                continue.
            let window = slice_mut(output, written, len(output) - written).
            let count = JsonEmitScalar(scalar, window).
            borrow_end(window).
            if count < 0:
                return count.
            set written = written + usize(count).
        if written == len(output):
            return -28.
        put(output, written, u8(34)).
        return i64(written + 1).
