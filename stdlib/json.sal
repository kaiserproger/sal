# Native JSON parsing is allocation-free. Offsets and counts are bytes.
# -22 = malformed input, -28 = insufficient output capacity, -75 = overflow.
# UnsafeMemory writers may leave partial output on ANY error; no trailing NUL.
# The caller owns valid writable memory for the supplied output/capacity.
# Output must not overwrite unread input (the caller controls raw-memory aliasing).
use "bytes.sal".

# An endpoint start == len(input) is valid; only space, tab, CR and LF are skipped.
operation JsonWhitespaceEnd:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    body:
        if start > len(input):
            return -22.
        let mut offset = start.
        while offset < len(input):
            let ch = byte(input, offset).
            if ch != 32 && ch != 9 && ch != 10 && ch != 13:
                return i64(offset).
            set offset = offset + 1.
        return i64(offset).

operation JsonDigit:
    accepts ch of type u8.
    returns bool.
    body:
        return ch >= 48 && ch <= 57.

operation JsonHexQuad:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    body:
        if start > len(input):
            return -22.
        if len(input) - start < 4:
            return -22.
        let mut value = 0.
        let mut index = usize(0).
        while index < 4:
            let digit = BytesHexDigit(byte(input, start + index)).
            if digit < 0:
                return -22.
            set value = value * 16 + digit.
            set index = index + 1.
        return value.

operation JsonScalarWidth:
    accepts scalar of type i64.
    returns usize.
    body:
        if scalar < 128:
            return usize(1).
        if scalar < 2048:
            return usize(2).
        if scalar < 65536:
            return usize(3).
        return usize(4).

# Decode a single raw UTF-8 scalar; reject overlongs, surrogates and > U+10FFFF.
operation JsonUtf8Scalar:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    body:
        if start >= len(input):
            return -22.
        let first = i64(byte(input, start)).
        if first < 128:
            return first.
        if first < 194:
            return -22.
        let mut width = usize(2).
        let mut value = first - 192.
        let mut minimum = 128.
        if first >= 224:
            set width = usize(3).
            set value = first - 224.
            set minimum = 2048.
        if first >= 240:
            set width = usize(4).
            set value = first - 240.
            set minimum = 65536.
        if first > 244:
            return -22.
        if len(input) - start < width:
            return -22.
        let mut index = usize(1).
        while index < width:
            let next = i64(byte(input, start + index)).
            if next < 128:
                return -22.
            if next > 191:
                return -22.
            set value = value * 64 + next - 128.
            set index = index + 1.
        if value < minimum:
            return -22.
        if value > 1114111:
            return -22.
        if value >= 55296 && value <= 57343:
            return -22.
        return value.

# start is the backslash, not the u. Paired UTF-16 escapes form one scalar.
operation JsonEscapeScalar:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    body:
        if start >= len(input):
            return -22.
        if len(input) - start < 2:
            return -22.
        let ch = byte(input, start + 1).
        if ch == 34:
            return 34.
        if ch == 92:
            return 92.
        if ch == 47:
            return 47.
        if ch == 98:
            return 8.
        if ch == 102:
            return 12.
        if ch == 110:
            return 10.
        if ch == 114:
            return 13.
        if ch == 116:
            return 9.
        if ch != 117:
            return -22.
        let high = JsonHexQuad(input, start + 2).
        if high < 0:
            return -22.
        if high >= 56320 && high <= 57343:
            return -22.
        if high < 55296:
            return high.
        if high > 56319:
            return high.
        if len(input) - start < 12:
            return -22.
        if byte(input, start + 6) != 92:
            return -22.
        if byte(input, start + 7) != 117:
            return -22.
        let low = JsonHexQuad(input, start + 8).
        if low < 56320:
            return -22.
        if low > 57343:
            return -22.
        return 65536 + (high - 55296) * 1024 + low - 56320.

operation JsonCharacterScalar:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    body:
        if start >= len(input):
            return -22.
        let ch = byte(input, start).
        if ch < 32:
            return -22.
        if ch == 92:
            return JsonEscapeScalar(input, start).
        return JsonUtf8Scalar(input, start).

# Called only after JsonCharacterScalar succeeded at start.
operation JsonCharacterWidth:
    accepts input of type Bytes.
    accepts start of type usize.
    accepts scalar of type i64.
    returns usize.
    body:
        if byte(input, start) != 92:
            return JsonScalarWidth(scalar).
        if byte(input, start + 1) != 117:
            return usize(2).
        if scalar >= 65536:
            return usize(12).
        return usize(6).

# start must name an opening quote; success excludes any following bytes.
operation JsonStringEnd:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    body:
        if start >= len(input):
            return -22.
        if byte(input, start) != 34:
            return -22.
        let mut offset = start + 1.
        while offset < len(input):
            if byte(input, offset) == 34:
                return i64(offset + 1).
            let scalar = JsonCharacterScalar(input, offset).
            if scalar < 0:
                return -22.
            set offset = offset + JsonCharacterWidth(input, offset, scalar).
        return -22.

operation JsonDigitsEnd:
    accepts input of type Bytes.
    accepts start of type usize.
    returns usize.
    body:
        let mut offset = start.
        while offset < len(input):
            if JsonDigit(byte(input, offset)) == false:
                return offset.
            set offset = offset + 1.
        return offset.

operation JsonNumberEnd:
    accepts input of type Bytes.
    accepts start of type usize.
    returns i64.
    body:
        if start >= len(input):
            return -22.
        let mut offset = start.
        if byte(input, offset) == 45:
            set offset = offset + 1.
        if offset == len(input):
            return -22.
        if byte(input, offset) == 48:
            set offset = offset + 1.
            if offset < len(input) && JsonDigit(byte(input, offset)):
                return -22.
        else:
            if JsonDigit(byte(input, offset)) == false:
                return -22.
            set offset = JsonDigitsEnd(input, offset).
        if offset < len(input) && byte(input, offset) == 46:
            set offset = offset + 1.
            let digits = offset.
            set offset = JsonDigitsEnd(input, offset).
            if offset == digits:
                return -22.
        if offset < len(input):
            let ch = byte(input, offset).
            if ch == 101 || ch == 69:
                set offset = offset + 1.
                if offset < len(input):
                    let sign = byte(input, offset).
                    if sign == 43 || sign == 45:
                        set offset = offset + 1.
                let digits = offset.
                set offset = JsonDigitsEnd(input, offset).
                if offset == digits:
                    return -22.
        return i64(offset).

# Each value consumes one level, including scalar values. Budget zero rejects.
# Only containers recurse; the caller's explicit decreasing budget bounds stack use.
# Leading whitespace is skipped. Success ends at the value, not trailing bytes.
# Object keys must be strings; duplicate-key policy belongs to the application.
operation JsonValueEnd:
    accepts input of type Bytes.
    accepts start of type usize.
    accepts depth of type usize.
    returns i64.
    body:
        if depth == 0:
            return -22.
        let skipped = JsonWhitespaceEnd(input, start).
        if skipped < 0:
            return -22.
        let mut offset = usize(skipped).
        if offset == len(input):
            return -22.
        let ch = byte(input, offset).
        if ch == 34:
            return JsonStringEnd(input, offset).
        if ch == 116:
            if BytesStartsWith(slice(input, offset, len(input) - offset), bytes("true")):
                return i64(offset + 4).
            return -22.
        if ch == 102:
            if BytesStartsWith(slice(input, offset, len(input) - offset), bytes("false")):
                return i64(offset + 5).
            return -22.
        if ch == 110:
            if BytesStartsWith(slice(input, offset, len(input) - offset), bytes("null")):
                return i64(offset + 4).
            return -22.
        let mut closing = u8(0).
        if ch == 91:
            set closing = u8(93).
        if ch == 123:
            set closing = u8(125).
        if closing == 0:
            return JsonNumberEnd(input, offset).
        set offset = usize(JsonWhitespaceEnd(input, offset + 1)).
        if offset == len(input):
            return -22.
        if byte(input, offset) == closing:
            return i64(offset + 1).
        while offset < len(input):
            if ch == 123:
                let key = JsonStringEnd(input, offset).
                if key < 0:
                    return -22.
                set offset = usize(JsonWhitespaceEnd(input, usize(key))).
                if offset == len(input):
                    return -22.
                if byte(input, offset) != 58:
                    return -22.
                set offset = offset + 1.
            let value = JsonValueEnd(input, offset, depth - 1).
            if value < 0:
                return -22.
            set offset = usize(JsonWhitespaceEnd(input, usize(value))).
            if offset == len(input):
                return -22.
            if byte(input, offset) == closing:
                return i64(offset + 1).
            if byte(input, offset) != 44:
                return -22.
            set offset = usize(JsonWhitespaceEnd(input, offset + 1)).
            if offset == len(input):
                return -22.
            if byte(input, offset) == closing:
                return -22.
        return -22.

operation JsonValidate:
    accepts input of type Bytes.
    returns bool.
    body:
        let end = JsonValueEnd(input, usize(0), usize(64)).
        if end < 0:
            return false.
        return JsonWhitespaceEnd(input, usize(end)) == i64(len(input)).

operation JsonUnsigned:
    accepts input of type Bytes.
    returns i64.
    body:
        if len(input) == 0:
            return -22.
        if len(input) > 1 && byte(input, usize(0)) == 48:
            return -22.
        # Validate the entire grammar before reporting numerical overflow.
        let mut index = usize(0).
        while index < len(input):
            if JsonDigit(byte(input, index)) == false:
                return -22.
            set index = index + 1.
        return BytesParseDecimal(input).

operation JsonEmitScalar:
    accepts scalar of type i64.
    accepts output of type usize.
    accepts capacity of type usize.
    returns i64.
    effects: UnsafeMemory.
    body:
        let width = JsonScalarWidth(scalar).
        if capacity < width:
            return -28.
        if width == 1:
            store8(output, u8(scalar)).
        if width == 2:
            store8(output, u8(192 + scalar / 64)).
            store8(output + 1, u8(128 + scalar % 64)).
        if width == 3:
            store8(output, u8(224 + scalar / 4096)).
            store8(output + 1, u8(128 + scalar / 64 % 64)).
            store8(output + 2, u8(128 + scalar % 64)).
        if width == 4:
            store8(output, u8(240 + scalar / 262144)).
            store8(output + 1, u8(128 + scalar / 4096 % 64)).
            store8(output + 2, u8(128 + scalar / 64 % 64)).
            store8(output + 3, u8(128 + scalar % 64)).
        return i64(width).

operation JsonDecodeString:
    accepts input of type Bytes.
    accepts start of type usize.
    accepts output of type usize.
    accepts capacity of type usize.
    returns i64.
    effects: UnsafeMemory.
    body:
        if start >= len(input):
            return -22.
        if byte(input, start) != 34:
            return -22.
        let mut offset = start + 1.
        let mut written = usize(0).
        while offset < len(input):
            if byte(input, offset) == 34:
                return i64(written).
            let scalar = JsonCharacterScalar(input, offset).
            if scalar < 0:
                return -22.
            let count = JsonEmitScalar(scalar, output + written, capacity - written).
            if count < 0:
                return count.
            set written = written + usize(count).
            set offset = offset + JsonCharacterWidth(input, offset, scalar).
        return -22.

operation JsonWriteString:
    accepts value of type Bytes.
    accepts output of type usize.
    accepts capacity of type usize.
    returns i64.
    effects: UnsafeMemory.
    body:
        if capacity == 0:
            return -28.
        store8(output, u8(34)).
        let mut written = usize(1).
        let mut offset = usize(0).
        while offset < len(value):
            let scalar = JsonUtf8Scalar(value, offset).
            if scalar < 0:
                return -22.
            set offset = offset + JsonScalarWidth(scalar).
            if scalar < 32:
                if capacity - written < 6:
                    return -28.
                store8(output + written, u8(92)).
                store8(output + written + 1, u8(117)).
                store8(output + written + 2, u8(48)).
                store8(output + written + 3, u8(48)).
                store8(output + written + 4, byte(bytes("0123456789abcdef"), usize(scalar / 16))).
                store8(output + written + 5, byte(bytes("0123456789abcdef"), usize(scalar % 16))).
                set written = written + 6.
                continue.
            if scalar == 34 || scalar == 92:
                if capacity - written < 2:
                    return -28.
                store8(output + written, u8(92)).
                store8(output + written + 1, u8(scalar)).
                set written = written + 2.
                continue.
            let count = JsonEmitScalar(scalar, output + written, capacity - written).
            if count < 0:
                return count.
            set written = written + usize(count).
        if written == capacity:
            return -28.
        store8(output + written, u8(34)).
        return i64(written + 1).
