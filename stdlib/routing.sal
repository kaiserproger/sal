use "bytes.sal".

# Native SAL routing: literal raw matching with :NAME single-segment captures
# and strict percent/UTF-8 decoding. No allocation, no JSON dependency.
# All names are Route-prefixed. Only BytesHexDigit is reused from bytes.sal.
#
# Paths are origin-form byte spans starting with /. Literal segments match raw
# bytes exactly; :NAME captures exactly one nonempty raw segment. Segment count
# is exact: root (/) and trailing empty literals count. Empty or malformed
# patterns never match. Literal %/+ bytes are not decoded; captures stay raw
# and must be passed through RouteDecode when decoded text is wanted.
#
# Error convention: RouteMatch returns bool; RouteCapture returns empty Bytes
# on mismatch, missing name, or empty name; RouteDecode returns decoded byte
# count, -22 malformed input or invalid UTF-8, -28 insufficient capacity.
# Lifetime: RouteScan/RouteCapture return zero-copy views borrowing path;
# the caller keeps path alive while using them. RouteDecode writes exactly the
# returned count on success with no terminator; on any error a valid decoded
# prefix may already be stored. The caller owns writable output/capacity and
# must keep it disjoint from unread input bytes.
#

# Internal single-pass scanner shared by RouteMatch and RouteCapture.
# name empty selects match mode: returns path itself on full match, empty on
# mismatch. name nonempty selects capture mode: returns the last slice whose
# :name equals name, empty when nothing matches. Malformed patterns (empty,
# missing leading slash, lone colon) return empty in both modes.
# Pure, no allocation; returned views borrow path. Endpoint and slash bounds
# are header requires clauses with empty-bytes otherwise values.
operation RouteScan:
    accepts pattern of type Bytes.
    accepts path of type Bytes.
    accepts name of type Bytes.
    returns Bytes from path.
    requires:
        len(pattern) > usize(0) otherwise bytes("").
        len(path) > usize(0) otherwise bytes("").
        byte(pattern, usize(0)) == 47 otherwise bytes("").
        byte(path, usize(0)) == 47 otherwise bytes("").
    body:
        let internal = len(name) == 0.
        let mut pi = usize(1).
        let mut qi = usize(1).
        let mut found = bytes("").
        while true:
            let mut pe = pi.
            while pe < len(pattern) && byte(pattern, pe) != 47:
                set pe = pe + 1.
            let mut qe = qi.
            while qe < len(path) && byte(path, qe) != 47:
                set qe = qe + 1.
            let plen = pe - pi.
            let qlen = qe - qi.
            if plen != 0 && byte(pattern, pi) == 58:
                if plen == 1 || qlen == 0:
                    return bytes("").
                if !internal && slice(pattern, pi + 1, plen - 1) == name:
                    set found = slice(path, qi, qlen).
            else:
                if plen != qlen || slice(pattern, pi, plen) != slice(path, qi, qlen):
                    return bytes("").
            if pe == len(pattern) && qe == len(path):
                if internal:
                    return path.
                return found.
            if pe == len(pattern) || qe == len(path):
                return bytes("").
            set pi = pe + 1.
            set qi = qe + 1.
        return bytes("").

# Pure exact route match derived from the shared scanner, not a second pass.
# True only for origin paths with identical segment counts, raw literal
# equality, and one nonempty raw segment per :NAME slot.
operation RouteMatch:
    accepts pattern of type Bytes.
    accepts path of type Bytes.
    returns bool.
    body:
        return len(RouteScan(pattern, path, bytes(""))) != 0.

# Pure raw zero-copy capture. Returns the last segment when :name repeats,
# empty Bytes on mismatch, unknown names, or empty names. The public empty
# name guard keeps match-mode path returns internal to RouteScan.
operation RouteCapture:
    accepts pattern of type Bytes.
    accepts path of type Bytes.
    accepts name of type Bytes.
    returns Bytes from path.
    requires:
        len(name) > usize(0) otherwise bytes("").
    body:
        return RouteScan(pattern, path, name).

# UTF-8 transition tables are separate from the decoder's prefix-writing loop.
# A negative need is the malformed-input status; no output is written for it.
entity RouteUtf8:
    has need of type i64.
    has scalar of type i64.
    has minimum of type i64.

operation RouteUtf8Lead:
    accepts current of type i64.
    returns RouteUtf8.
    requires:
        current >= 128 otherwise RouteUtf8(0, current, current).
        current >= 194 otherwise RouteUtf8(-22, 0, 0).
        current > 223 otherwise RouteUtf8(1, current - 192, 128).
        current > 239 otherwise RouteUtf8(2, current - 224, 2048).
        current <= 244 otherwise RouteUtf8(-22, 0, 0).
    body:
        return RouteUtf8(3, current - 240, 65536).

operation RouteUtf8Complete:
    accepts need of type i64.
    accepts scalar of type i64.
    accepts minimum of type i64.
    returns RouteUtf8.
    requires:
        need != 0 || (scalar >= minimum && scalar <= 1114111 && (scalar < 55296 || scalar > 57343)) otherwise RouteUtf8(-22, 0, 0).
    body:
        return RouteUtf8(need, scalar, minimum).

operation RouteUtf8Advance:
    accepts current of type i64.
    accepts need of type i64.
    accepts scalar of type i64.
    accepts minimum of type i64.
    returns RouteUtf8.
    requires:
        need != 0 otherwise RouteUtf8Lead(current).
        current >= 128 && current <= 191 otherwise RouteUtf8(-22, 0, 0).
    body:
        return RouteUtf8Complete(need - 1, scalar * 64 + current - 128, minimum).

# Strict percent-decode with streaming UTF-8 validation in one pass.
# Percent escapes (%HH, either hex case) emit one byte; + stays plus (43).
# Escapes may yield slash or NUL. Raw and decoded bytes feed one UTF-8 state
# machine: ASCII passes, 2-byte starts are 194..223, 3-byte 224..239, 4-byte
# 240..244; continuations are 128..191. Overlongs, surrogates 55296..57343,
# values above 1114111, lone continuations, and truncation are -22. Codepoint
# arithmetic stays i64 because u8 math is checked. Hex uses BytesHexDigit.
# Loan length is checked per emitted byte after validation, so -22 precedes
# -28 at the same byte; exact small loans succeed (%41 needs one byte).
# Only bytes validated so far are stored, so errors leave a valid prefix.
# No terminator, no allocation. Caller supplies disjoint writable loan.
operation RouteDecode:
    accepts value of type Bytes.
    accepts output of type MutBytes.
    returns i64.
    body:
        let mut read = usize(0).
        let mut written = usize(0).
        let mut need = 0.
        let mut scalar = 0.
        let mut minimum = 0.
        while read < len(value):
            let octet = byte(value, read).
            let mut current = i64(octet).
            if octet == 37:
                if len(value) - read < 3:
                    return -22.
                let high = BytesHexDigit(byte(value, read + 1)).
                if high < 0:
                    return -22.
                let low = BytesHexDigit(byte(value, read + 2)).
                if low < 0:
                    return -22.
                set current = high * 16 + low.
                set read = read + 3.
            else:
                set read = read + 1.
            let next = RouteUtf8Advance(current, need, scalar, minimum).
            if next.need < 0:
                return -22.
            set need = next.need.
            set scalar = next.scalar.
            set minimum = next.minimum.
            if written >= len(output):
                return -28.
            put(output, written, u8(current)).
            set written = written + 1.
        if need != 0:
            return -22.
        return i64(written).
