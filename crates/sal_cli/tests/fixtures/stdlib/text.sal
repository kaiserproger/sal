# mapping. Returns 0 when every check holds, otherwise the first failing
# check number. Asserts only observable results and positions, never source
# text or wiring. No raw addresses, no UnsafeMemory: the scratch area is an
# owned Buffer loaned as MutBytes and written with put; views are consumed
# within their checking statement and the loan is ended before drop.
operation Main:
    returns i64.
    effects: SystemCall.
    body:
        let mut failure = 0.
