use "std/concurrency.sal".
operation Main:
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        let mut failure = 0.
        let ch = channel(i64, usize(2)).
        let first = send(ch, 11).
        if first.sent == false:
            if failure == 0:
                set failure = 1.
        if first.value != 11:
            if failure == 0:
                set failure = 2.
        let second = send(ch, 22).
        if second.sent == false:
            if failure == 0:
                set failure = 3.
        if second.value != 22:
            if failure == 0:
                set failure = 4.
        if close(ch) == false:
            if failure == 0:
                set failure = 5.
        let drain_one = receive(ch).
        if drain_one.open == false:
            if failure == 0:
                set failure = 6.
        if drain_one.value != 11:
            if failure == 0:
                set failure = 7.
        let drain_two = receive(ch).
        if drain_two.open == false:
            if failure == 0:
                set failure = 8.
        if drain_two.value != 22:
            if failure == 0:
                set failure = 9.
        let closed = receive(ch).
        if closed.open == true:
            if failure == 0:
                set failure = 10.
        if closed.value != 0:
            if failure == 0:
                set failure = 11.
        channel_drop(ch).
        return failure.
