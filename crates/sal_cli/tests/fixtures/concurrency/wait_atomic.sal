use "std/concurrency.sal".
operation Main:
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        let mut failure = 0.
        let left = channel(i64, usize(1)).
        let right = channel(i64, usize(1)).
        let one = send(left, 11).
        if one.sent == false:
            if failure == 0:
                set failure = 1.
        let two = send(right, 22).
        if two.sent == false:
            if failure == 0:
                set failure = 2.
        let winner = wait_for(receive(left), receive(right)).
        if winner.status != 0:
            if failure == 0:
                set failure = 3.
        if winner.index == 0:
            if winner.arm0.selected == false:
                if failure == 0:
                    set failure = 4.
            if winner.arm0.open == false:
                if failure == 0:
                    set failure = 5.
            if winner.arm0.value != 11:
                if failure == 0:
                    set failure = 6.
            if winner.arm1.selected == true:
                if failure == 0:
                    set failure = 7.
            if winner.arm1.value != 0:
                if failure == 0:
                    set failure = 8.
            let other = receive(right).
            if other.open == false:
                if failure == 0:
                    set failure = 9.
            if other.value != 22:
                if failure == 0:
                    set failure = 10.
        else:
            if winner.index != 1:
                if failure == 0:
                    set failure = 11.
            if winner.arm1.selected == false:
                if failure == 0:
                    set failure = 12.
            if winner.arm1.open == false:
                if failure == 0:
                    set failure = 13.
            if winner.arm1.value != 22:
                if failure == 0:
                    set failure = 14.
            if winner.arm0.selected == true:
                if failure == 0:
                    set failure = 15.
            if winner.arm0.value != 0:
                if failure == 0:
                    set failure = 16.
            let other = receive(left).
            if other.open == false:
                if failure == 0:
                    set failure = 17.
            if other.value != 11:
                if failure == 0:
                    set failure = 18.
        channel_drop(left).
        channel_drop(right).
        return failure.
