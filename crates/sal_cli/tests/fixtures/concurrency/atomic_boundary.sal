use "std/linux/memory.sal".

# First failure wins: keeps an earlier failure, else reports `code` when the
# check does not hold.
operation Expect:
    accepts failure of type i64.
    accepts code of type i64.
    accepts holds of type bool.
    returns i64.
    requires:
        failure == 0 otherwise failure.
        holds otherwise code.
    body:
        return 0.

operation Main:
    returns i64.
    effects: SystemCall, UnsafeMemory.
    body:
        let mapping = LinuxMapMemory(usize(4096)).
        if mapping < 0:
            return 1.
        let buf = usize(mapping).
        let mut failure = 0.
        store64(buf, usize(123456789)).
        set failure = Expect(failure, 2, load64(buf) == usize(123456789)).
        atomic_store(buf, u32(7)).
        set failure = Expect(failure, 3, atomic_load(buf) == u32(7)).
        set failure = Expect(failure, 4, atomic_cas(buf, u32(7), u32(8)) == u32(7)).
        set failure = Expect(failure, 5, atomic_load(buf) == u32(8)).
        set failure = Expect(failure, 6, atomic_cas(buf, u32(7), u32(9)) == u32(8)).
        set failure = Expect(failure, 7, atomic_load(buf) == u32(8)).
        set failure = Expect(failure, 8, LinuxUnmapMemory(buf, usize(4096)) == 0).
        return failure.
